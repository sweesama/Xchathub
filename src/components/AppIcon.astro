---
/**
 * AppIcon.astro — App 图标组件（真 logo，永远一致）
 *
 * 三种渲染模式，按优先级：
 *   1. `logoUrl`   —— 本地真彩色图（Briar 用它，因为 simple-icons 里没有）。
 *                      渲染为 <img>，保留原色（PNG/SVG 都可）。
 *   2. `simpleIconsSlug` —— 从 simple-icons CDN 拿 SVG 当 CSS mask 用，
 *                            白色填 logo 形状铺在 brandColor 底上 ——
 *                            得到「品牌色方块 + 白 logo」的一致效果。
 *   3. fallback     —— brandColor 底 + 白 monogram（最后兜底）。
 *
 * 视觉规则：
 *   - 容器方块 = brandColor（没有白边、没有透明缝）
 *   - logo 永远白色（mask）或原色（image），
 *     size 由外部 class 控制（top-monogram / vs-monogram / trio-monogram 等）
 */

interface App {
  name: string;
  monogram: string;
  brandColor: string;
  website: string;
  simpleIconsSlug?: string;
  /** 本地图标 URL（相对于站点根，例如 `/app-icons/briar.png`）*/
  logoUrl?: string;
}

interface Props {
  app: App;
  class?: string;
}

const { app, class: className = '' } = Astro.props;

const SIMPLE_ICONS_CDN = 'https://cdn.jsdelivr.net/npm/simple-icons@latest/icons';

// 优先级：本地 logoUrl > simple-icons > monogram
const renderMode: 'image' | 'mask' | 'monogram' = app.logoUrl
  ? 'image'
  : app.simpleIconsSlug
    ? 'mask'
    : 'monogram';

const maskUrl = renderMode === 'mask'
  ? `${SIMPLE_ICONS_CDN}/${app.simpleIconsSlug}.svg`
  : '';
---

<span
  class={`app-icon ${className}`}
  data-mode={renderMode}
  style={`background:${app.brandColor};`}
>
  {renderMode === 'image' && (
    <img
      class="app-icon-img"
      src={app.logoUrl}
      alt={`${app.name} logo`}
      loading="lazy"
      decoding="async"
      width="120"
      height="120"
    />
  )}
  {renderMode === 'mask' && (
    <span
      class="app-icon-mask"
      style={`--mask:url(${maskUrl});`}
      role="img"
      aria-label={`${app.name} logo`}
    ></span>
  )}
  {renderMode === 'monogram' && (
    <span class="app-icon-monogram" aria-label={`${app.name} logo`}>{app.monogram}</span>
  )}
</span>

<style is:global>
  /* Astro scoped CSS 隔离问题：所有 size variants 放在 :global，
     这样 page 里给 AppIcon 加 `class="vs-monogram"` 等就能命中 */
  .app-icon[class*="top-monogram"]     { width: 60px;  height: 60px;  border-radius: 14px; }
  .app-icon[class*="vs-monogram"]      { width: 48px;  height: 48px;  border-radius: 12px; }
  .app-icon[class*="related-monogram"] { width: 44px;  height: 44px;  border-radius: 10px; }
  .app-icon[class*="pick-monogram"]    { width: 48px;  height: 48px;  border-radius: 12px; }
  .app-icon[class*="rank-monogram"]    { width: 40px;  height: 40px;  border-radius: 10px; }
  .app-icon[class*="hero-monogram"]    { width: 88px;  height: 88px;  border-radius: 20px; }
  .app-icon[class*="trio-monogram"]    { width: 56px;  height: 56px;  border-radius: 14px; }
  .app-icon[class*="cta-monogram"]     { width: 48px;  height: 48px;  border-radius: 12px; }
</style>

<style>
  /* 容器：品牌色方块，无白边（背景由 inline style 设 brandColor）*/
  .app-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  /* image 模式：原色 <img>，contain 保证 logo 完整可见，
     宽高留白 6% 让 logo 边缘不贴死 */
  .app-icon-img {
    display: block;
    width: 88%;
    height: 88%;
    object-fit: contain;
    object-position: center;
    pointer-events: none;
    user-select: none;
  }

  /* mask 模式：SVG 当 alpha 蒙版，logo 形状显示为白色 */
  .app-icon-mask {
    display: block;
    width: 62%;
    height: 62%;
    background: #fff;
    -webkit-mask-image: var(--mask);
            mask-image: var(--mask);
    -webkit-mask-size: contain;
            mask-size: contain;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    -webkit-mask-position: center;
            mask-position: center;
    pointer-events: none;
    user-select: none;
  }

  /* monogram 兜底：占满容器，白色粗体字 */
  .app-icon-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-weight: 800;
    color: white;
    font-size: 0.42em;
    line-height: 1;
    letter-spacing: -0.02em;
    pointer-events: none;
    user-select: none;
  }
</style>
