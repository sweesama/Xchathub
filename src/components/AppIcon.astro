---
/**
 * AppIcon.astro — App 图标组件
 *
 * 策略：
 *   1. 从 app.website URL 提取 domain → 调用 Google Favicon 服务 (sz=256)
 *   2. 图片加载失败 → 自动 remove <img>，回退到背景色 + monogram
 *   3. website 字段无效 → 直接显示 monogram
 *
 * 呈现：
 *   - 保留 favicon 原色（彩色让用户一眼认出 app）
 *   - object-fit: contain 让任何比例 (Signal 长方形 logo / Threema 正方形) 完整显示
 *   - 背景用 app.brandColor 作为「底色」让 logo 在品牌色里 100% 跳出来
 *   - monogram fallback 与 logo 等大，加粗白色，保证 fallback 也不失效
 *
 * 使用方法：
 *   <AppIcon app={app} class="hero-monogram" />
 *   <AppIcon app={other} class="related-monogram" />
 */

interface App {
  name: string;
  monogram: string;
  brandColor: string;
  website: string;
}

interface Props {
  app: App;
  class?: string;
}

const { app, class: className = '' } = Astro.props;

function getDomain(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

const domain = getDomain(app.website);
const faviconUrl = domain
  ? `https://www.google.com/s2/favicons?domain=${domain}&sz=256`
  : '';
---

<span class={`app-icon ${className}`}>
  {faviconUrl && (
    <img
      src={faviconUrl}
      alt={`${app.name} logo`}
      loading="lazy"
      decoding="async"
      onerror="this.remove()"
    />
  )}
  <span class="app-icon-monogram" style={`background:${app.brandColor}; color:white;`}>{app.monogram}</span>
</span>

<style>
  /* 容器：统一「白底卡片」让任何 logo 都能完整显示
     - 浅色边框让浅色 logo（如 Signal 浅蓝）和白底可区分
     - 8% padding 防止 logo 贴边
     - flex 居中让 logo + monogram 都能完美对中
  */
  .app-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: white;
    padding: 8%;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  /* logo: 在 flex 容器内填满 padding 之外的区域，contain 不变形 */
  .app-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 1;
    pointer-events: none;
    user-select: none;
  }

  /* monogram fallback / 无 website：品牌色背景填充，浮于 logo 之下作为 fallback */
  .app-icon-monogram {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    color: white;
    font-size: 0.5em;
    line-height: 1;
    letter-spacing: -0.02em;
    pointer-events: none;
    user-select: none;
  }
</style>