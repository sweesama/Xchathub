---
/**
 * AppIcon.astro — App 图标组件
 *
 * 策略：
 *   1. 从 app.website URL 提取 domain → 调用 Google Favicon 服务 (sz=256)
 *   2. 图片加载失败 → 自动 remove <img>，回退到背景色 + monogram
 *   3. website 字段无效 → 直接显示 monogram
 *
 * 呈现：
 *   - 保留 favicon 原色（彩色让用户一眼认出 app）
 *   - object-fit: contain 让任何比例 (Signal 长方形 logo / Threema 正方形) 完整显示
 *   - 背景用 app.brandColor 作为「底色」让 logo 在品牌色里 100% 跳出来
 *   - monogram fallback 与 logo 等大，加粗白色，保证 fallback 也不失效
 *
 * 使用方法：
 *   <AppIcon app={app} class="hero-monogram" />
 *   <AppIcon app={other} class="related-monogram" />
 */

interface App {
  name: string;
  monogram: string;
  brandColor: string;
  website: string;
}

interface Props {
  app: App;
  class?: string;
}

const { app, class: className = '' } = Astro.props;

function getDomain(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

const domain = getDomain(app.website);
const faviconUrl = domain
  ? `https://www.google.com/s2/favicons?domain=${domain}&sz=256`
  : '';
---

<span class={`app-icon ${className}`} style={`background:${app.brandColor}`}>
  {faviconUrl && (
    <img
      src={faviconUrl}
      alt={`${app.name} logo`}
      loading="lazy"
      decoding="async"
      onerror="this.remove()"
    />
  )}
  <span class="app-icon-monogram">{app.monogram}</span>
</span>

<style>
  /* Container: 尊重外层 class 设置的 width/height/border-radius；
     内部 flex 让 img 与 monogram 均能在容器中完美居中 */
  .app-icon {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* <img>: 去掉 inset（16%）带来的额外 padding，只用 8% 内边距让 logo 不贴边；
     contain + max-height/max-width 保证长方形 logo 完整而不变形 */
  .app-icon img {
    display: block;
    width: 84%;
    height: 84%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    z-index: 1;
    pointer-events: none;
    user-select: none;
  }

  /* monogram（fallback / 无 website）：占满整个容器，加粗白色。
     使用 em 单位跟随容器 width 自适应 — 32px 容器上 ~14.4px，88px 上 ~40px */
  .app-icon-monogram {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: white;
    font-size: 0.45em;
    line-height: 1;
    letter-spacing: -0.02em;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  /* img 加载后蒙住 monogram */
  .app-icon img + .app-icon-monogram,
  .app-icon img ~ .app-icon-monogram {
    z-index: 0;
  }
</style>