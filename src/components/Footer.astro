---
/**
 * Footer.astro — 全站底部
 * 包含免责声明、版权信息和快速链接
 */
import { XCHAT_TELEGRAM_CHANNEL_URL, XCHAT_TELEGRAM_COMMUNITY_URL } from '../data/xchat';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <hr class="divider" />
    <div class="footer-inner">
      <p class="disclaimer">
        This is an <strong>unofficial</strong> community project. Not affiliated with X Corp, Meta, Signal Foundation, Threema GmbH, or any other messaging app vendor.
        All trademarks, brand names, and app icons belong to their respective owners.
        App logos are retrieved from each vendor's official domain via Google's Favicon service for identification only.
      </p>
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col">
          <span class="footer-heading">Home</span>
          <a href="/">Homepage</a>
          <a href="/best-encrypted-messaging-apps">Best 2026 Ranking</a>
          <a href="/groups">Groups Directory</a>
          <a href="/faq">FAQ</a>
        </div>
        <div class="footer-col">
          <span class="footer-heading">Reviews</span>
          <a href="/reviews/signal/">Signal</a>
          <a href="/reviews/threema/">Threema</a>
          <a href="/reviews/wire/">Wire</a>
          <a href="/reviews/session/">Session</a>
          <a href="/reviews/element/">Element</a>
          <a href="/reviews/whatsapp/">WhatsApp</a>
          <a href="/reviews/telegram/">Telegram</a>
          <a href="/reviews/briar/">Briar</a>
          <a href="/reviews/simplex/">SimpleX</a>
          <a href="/reviews/xchat/">XChat</a>
        </div>
        <div class="footer-col">
          <span class="footer-heading">Compare</span>
          <a href="/compare/signal-vs-threema/">Signal vs Threema</a>
          <a href="/compare/signal-vs-telegram/">Signal vs Telegram</a>
          <a href="/compare/whatsapp-vs-signal/">WhatsApp vs Signal</a>
          <a href="/compare/signal-vs-telegram-security/">Signal vs Telegram Security</a>
          <a href="/compare/signal-vs-whatsapp-security/">Signal vs WhatsApp Security</a>
          <a href="/compare/imessage-vs-signal/">iMessage vs Signal</a>
          <a href="/compare/signal-vs-whatsapp-vs-telegram/">Signal vs WhatsApp vs Telegram</a>
          <a href="/compare/wire-vs-signal-vs-threema/">Wire vs Signal vs Threema</a>
          <a href="/vs/whatsapp">XChat vs WhatsApp</a>
          <a href="/vs/signal">XChat vs Signal</a>
          <a href="/vs/telegram">XChat vs Telegram</a>
        </div>
        <div class="footer-col">
          <span class="footer-heading">Community</span>
          <a href={XCHAT_TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener noreferrer">Telegram Channel</a>
          <a href={XCHAT_TELEGRAM_COMMUNITY_URL} target="_blank" rel="noopener noreferrer">Telegram Community</a>
          <a href="/list-your-group">List Your Group</a>
          <a href="/communities-shutdown">X Communities Shutdown</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/affiliate-disclosure">Affiliate Disclosure</a>
        </div>
      </nav>

      <script is:inline>
        // 绑定 cookie preferences 按钮到 CookieBanner 的 openCookiePreferences
        // is:inline 关闭 TS 处理，绕过 strict mode 对 optional 调用的报错
        (function () {
          var prefBtn = document.querySelector('[data-cookie-preferences]');
          var openFn = window.openCookiePreferences;
          if (prefBtn && typeof openFn === 'function') {
            prefBtn.addEventListener('click', function () {
              openFn();
            });
          }
        })();
      </script>

      <p class="copyright">&copy; {year} XChat Hub. Built for the community.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 3rem 0 2rem;
  }

  .footer-inner {
    padding-top: 2rem;
    text-align: center;
  }

  .disclaimer {
    color: var(--text-muted);
    font-size: 0.8125rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  /* ---- 4-column footer nav ---- */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 920px;
    margin: 0 auto 2rem;
    text-align: left;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.375rem;
  }

  .footer-col a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.4;
    transition: color 0.15s;
  }

  .footer-col a:hover {
    color: var(--accent-light);
  }

  .copyright {
    color: var(--text-muted);
    font-size: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  /* Responsive: 2 columns on tablet, single scroll-friendly layout on mobile */
  @media (max-width: 720px) {
    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
      text-align: left;
      max-width: 440px;
    }
  }

  @media (max-width: 380px) {
    .footer-nav {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      max-width: 260px;
    }
  }

  /* Coming-soon placeholder (not a link) */
  .footer-soon {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
    margin-top: 0.25rem;
    padding-top: 0.375rem;
    border-top: 1px dashed var(--border);
  }
</style>
