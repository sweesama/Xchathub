<script is:inline>
  (function () {
    try {
      var banner = document.getElementById('launch-banner');
      var closeBtn = document.getElementById('launch-banner-close');
      var dismissed = localStorage.getItem('xchat-launch-banner-dismissed') === '1';
      if (banner && !dismissed) {
        banner.hidden = false;
        document.body.classList.add('has-launch-banner');
      }
      if (closeBtn) {
        closeBtn.addEventListener('click', function () {
          if (banner) banner.hidden = true;
          document.body.classList.remove('has-launch-banner');
          try { localStorage.setItem('xchat-launch-banner-dismissed', '1'); } catch (e) {}
        });
      }
    } catch (e) {}

    // 全站所有下拉菜单（Reviews / Compare）都要绑定 click 和 Esc 关闭
    var dropdowns = document.querySelectorAll('[data-dropdown]');
    dropdowns.forEach(function (dropdown) {
      var dropdownBtn = dropdown.querySelector('[data-dropdown-btn]');
      if (!dropdownBtn) return;
      dropdownBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        // 点开当前时，关闭其他已打开的下拉
        dropdowns.forEach(function (other) {
          if (other !== dropdown) {
            other.classList.remove('open');
            var otherBtn = other.querySelector('[data-dropdown-btn]');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
          }
        });
        var open = dropdown.classList.toggle('open');
        dropdownBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
    document.addEventListener('click', function (e) {
      dropdowns.forEach(function (dropdown) {
        if (!dropdown.contains(e.target)) {
          dropdown.classList.remove('open');
          var btn = dropdown.querySelector('[data-dropdown-btn]');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        dropdowns.forEach(function (dropdown) {
          dropdown.classList.remove('open');
          var btn = dropdown.querySelector('[data-dropdown-btn]');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        });
      }
    });

    var menuBtn = document.getElementById('mobile-menu-btn');
    var drawer = document.getElementById('mobile-drawer');
    function openDrawer() {
      if (!drawer) return;
      drawer.hidden = false;
      requestAnimationFrame(function () { drawer.classList.add('open'); });
      document.body.style.overflow = 'hidden';
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
    }
    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.remove('open');
      document.body.style.overflow = '';
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
      setTimeout(function () { drawer.hidden = true; }, 250);
    }
    if (menuBtn) menuBtn.addEventListener('click', openDrawer);
    if (drawer) {
      drawer.querySelectorAll('[data-drawer-close]').forEach(function (el) {
        el.addEventListener('click', closeDrawer);
      });
      drawer.querySelectorAll('.drawer-link, .drawer-cta').forEach(function (el) {
        el.addEventListener('click', closeDrawer);
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer && drawer.classList.contains('open')) closeDrawer();
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid var(--border);
  }

  :global(body.has-launch-banner) .site-header { top: 34px; }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.0625rem;
    flex-shrink: 0;
  }

  .logo-text { letter-spacing: -0.02em; }
  .logo-accent { color: var(--accent); }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link:hover { color: var(--text-primary); }

  .nav-link.active {
    color: var(--text-primary);
    position: relative;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    border-radius: 1px;
  }

  .nav-dropdown { position: relative; }

  .nav-dropdown-trigger svg {
    transition: transform 0.2s;
    opacity: 0.7;
  }

  .nav-dropdown.open .nav-dropdown-trigger svg { transform: rotate(180deg); }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    min-width: 240px;
    padding: 0.5rem;
    background: rgba(22, 24, 28, 0.98);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s, transform 0.15s var(--ease-smooth), visibility 0.15s;
  }

  .nav-dropdown.open .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.875rem;
    color: var(--text-primary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background 0.15s;
  }

  .dropdown-item:hover { background: rgba(29, 155, 240, 0.1); }

  .dropdown-title {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .dropdown-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    transition: background 0.15s;
  }

  .mobile-menu-btn:hover { background: rgba(255, 255, 255, 0.05); }

  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .mobile-drawer.open .mobile-drawer-backdrop { opacity: 1; }

  .mobile-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background: rgba(18, 20, 24, 0.98);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-left: 1px solid var(--border);
    transform: translateX(100%);
    transition: transform 0.25s var(--ease-smooth);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .mobile-drawer.open .mobile-drawer-panel { transform: translateX(0); }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .drawer-logo {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .drawer-close {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    display: inline-flex;
    transition: color 0.15s, background 0.15s;
  }

  .drawer-close:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .drawer-nav {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex: 1;
  }

  .drawer-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .drawer-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .drawer-link {
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 500;
    padding: 0.5rem 0;
    text-decoration: none;
    transition: color 0.15s;
  }

  .drawer-link:hover { color: var(--accent-light); }

  .drawer-cta {
    margin-top: auto;
    text-align: center;
  }

  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .mobile-menu-btn { display: inline-flex; }
  }

  /* === Coming-soon placeholders (not links, just info) === */
  .dropdown-soon,
  .drawer-soon {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.875rem;
    color: var(--text-muted);
    opacity: 0.85;
    border-top: 1px solid var(--border);
    margin-top: 0.375rem;
    pointer-events: none;
  }

  .dropdown-soon .dropdown-title,
  .drawer-soon {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .dropdown-soon .dropdown-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .drawer-soon {
    font-size: 0.75rem;
    line-height: 1.45;
    padding: 0.5rem 0;
    margin-top: 0.25rem;
  }
</style>
