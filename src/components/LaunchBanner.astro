---
/**
 * LaunchBanner.astro — iOS 上线顶部通知条。
 * 用户关闭后存 localStorage，下次不再显示。
 */
---

<div id="launch-banner" class="launch-banner" hidden>
  <div class="container launch-banner-inner">
    <span class="banner-pulse" aria-hidden="true"></span>
    <span class="banner-text">
      XChat is <strong>live on iOS</strong> — <a href="https://apps.apple.com/us/app/xchat/id6760873038" class="banner-cta" target="_blank" rel="noopener noreferrer">download now →</a>
    </span>
    <button id="launch-banner-close" class="banner-close" aria-label="Dismiss">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<style>
  .launch-banner {
    position: sticky;
    top: 0;
    z-index: 101;
    background:
      linear-gradient(90deg,
        rgba(29, 155, 240, 0.12),
        rgba(29, 155, 240, 0.18),
        rgba(29, 155, 240, 0.12)
      );
    border-bottom: 1px solid rgba(29, 155, 240, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.8125rem;
    line-height: 1;
  }

  .launch-banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem;
    position: relative;
    color: var(--text-primary);
    text-align: center;
  }

  .banner-pulse {
    width: 7px;
    height: 7px;
    background: #1d9bf0;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(29, 155, 240, 0.7);
    animation: banner-pulse 2s infinite;
    flex-shrink: 0;
  }

  @keyframes banner-pulse {
    0% { box-shadow: 0 0 0 0 rgba(29, 155, 240, 0.7); }
    70% { box-shadow: 0 0 0 8px rgba(29, 155, 240, 0); }
    100% { box-shadow: 0 0 0 0 rgba(29, 155, 240, 0); }
  }

  .banner-text { color: var(--text-secondary); }
  .banner-text strong { color: var(--text-primary); font-weight: 600; }

  .banner-cta {
    color: var(--accent-light);
    font-weight: 600;
    text-decoration: none;
    margin-left: 0.125rem;
    white-space: nowrap;
  }

  .banner-cta:hover { text-decoration: underline; }

  .banner-close {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.375rem;
    display: inline-flex;
    border-radius: var(--radius-full);
    transition: color 0.15s, background 0.15s;
  }

  .banner-close:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 480px) {
    .launch-banner-inner {
      padding: 0.5rem 2.5rem 0.5rem 0.75rem;
      font-size: 0.75rem;
    }

    .banner-text { line-height: 1.3; }
  }
</style>
