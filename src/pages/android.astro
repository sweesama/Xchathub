---
/**
 * android.astro — XChat on Android
 *
 * The standalone X Chat app (com.x.chat) left Google Play around 2026-09-14.
 * Chat remains inside the main X app and at chat.x.com. Do not link the dead listing.
 */
import Layout from '../layouts/Layout.astro';
import {
  XCHAT_CHAT_URL,
  XCHAT_TELEGRAM_CHANNEL_URL,
  XCHAT_TELEGRAM_COMMUNITY_URL,
  XCHAT_ANDROID_LAUNCH_DISPLAY,
  XCHAT_STANDALONE_APP_REMOVED_ON,
} from '../data/xchat';

const CHAT_URL = XCHAT_CHAT_URL;

/* JSON-LD: Article + FAQPage */
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'XChat on Android — use the X app or chat.x.com',
  description: `The separate X Chat app left Google Play around ${XCHAT_STANDALONE_APP_REMOVED_ON}. Use chat inside the X app or open chat.x.com. Do not install a third-party APK.`,
  author: { '@type': 'Organization', name: 'XChat Hub' },
  publisher: { '@type': 'Organization', name: 'XChat Hub', url: 'https://xchat.directory' },
  datePublished: '2026-04-24',
  dateModified: new Date().toISOString().split('T')[0],
};

const timeline = [
  { date: 'May 2025',     label: 'Internal beta',       desc: 'X starts internal testing of XChat with employees and select beta users.' },
  { date: 'Dec 2025',     label: 'chat.x.com launches', desc: 'X quietly releases a standalone web version at chat.x.com — accessible from any browser including Android.' },
  { date: 'Mar 2026',     label: 'Public iOS beta',     desc: 'XChat enters public TestFlight beta on iOS. No Android beta yet.' },
  { date: 'Apr 24, 2026', label: 'iOS public launch',   desc: 'XChat launches for iPhone and iPad. The separate App Store listing was later removed.' },
  { date: 'May 27, 2026', label: 'Android pre-registration', desc: 'X opens pre-registration for a separate Android build of XChat.' },
  { date: 'Jun 29, 2026', label: 'Android public launch', desc: `A separate Android app goes live on ${XCHAT_ANDROID_LAUNCH_DISPLAY}, announced on the official @chat account.` },
  { date: 'Sep 14, 2026', label: 'Standalone apps removed', desc: `Around ${XCHAT_STANDALONE_APP_REMOVED_ON}, X removes the separate X Chat app from the App Store and Google Play. Both listings now 404. Chat stays inside the X app and at chat.x.com.` },
];

const fakeApkRedFlags = [
  'Domain is not x.com or apple.com',
  'Asks you to enable "Install from Unknown Sources"',
  'Requests permissions that messaging apps don\'t need (SMS, contacts export, accessibility services)',
  'Has a slightly different name like "XChat Pro", "XChat+", "X Chat Plus"',
  'Promises "early access" or "leaked version"',
  'Has very few or only 5-star reviews on the source site',
];

const faqs = [
  {
    q: 'Is XChat available on Android?',
    a: `<strong>Yes — inside the X app, and at chat.x.com.</strong> The separate X Chat app left Google Play around ${XCHAT_STANDALONE_APP_REMOVED_ON}. Open the X app you already have, or use <a href="${CHAT_URL}" target="_blank" rel="noopener noreferrer">chat.x.com</a> in Chrome.`,
  },
  {
    q: 'What is the official XChat Android download link?',
    a: `There isn't one. The old Google Play listing now returns a 404. Use chat inside the X app, or open <a href="${CHAT_URL}" target="_blank" rel="noopener noreferrer">chat.x.com</a>. Do not download an "XChat.apk".`,
  },
  {
    q: 'Should I download an XChat APK from a third-party site?',
    a: '<strong>No.</strong> There is no official standalone APK. Sites offering "XChat.apk" are unnecessary and often bundle malware or credential stealers.',
  },
  {
    q: 'There are several apps called "XChat" on Google Play. Which is the real one?',
    a: 'None of them is the X Corp chat app anymore. X removed its standalone listing. An unrelated Nostr messenger also uses the name "XChat" and is not from X Corp. Use the main X app or chat.x.com.',
  },
  {
    q: 'Do my XChat messages sync across iOS, Android, and Web?',
    a: 'Yes. Chat inside the X app and chat.x.com share the same X account. Log in once and your messages and groups show up on each surface.',
  },
  {
    q: 'Can I use XChat on Android without installing anything new?',
    a: `Yes. <a href="${CHAT_URL}" target="_blank" rel="noopener noreferrer">chat.x.com</a> works in Chrome or any mobile browser and uses the same account. If you already have the X app, open chat there.`,
  },
  {
    q: 'Did XChat launch on iOS before Android?',
    a: `Yes. XChat launched on April 24, 2026, and a separate Android app followed on ${XCHAT_ANDROID_LAUNCH_DISPLAY}. Both standalone store listings were removed around ${XCHAT_STANDALONE_APP_REMOVED_ON}.`,
  },
  {
    q: 'Does XChat on Android cost money?',
    a: 'No. Chat inside the X app and chat.x.com are free to open. An X account is required to sign in.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a.replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<Layout
  title="XChat on Android — Use the X App or chat.x.com"
  description="The separate X Chat app was removed from Google Play around September 14, 2026. Use chat inside the X app or open chat.x.com. Do not install a third-party APK."
  jsonLd={[articleJsonLd, faqJsonLd]}
  canonicalPath="/android"
  breadcrumbs={[
    { name: 'Home', url: 'https://xchat.directory/' },
    { name: 'XChat for Android', url: 'https://xchat.directory/android/' },
  ]}
>
  <!-- ==================== HERO ==================== -->
  <section class="section hero">
    <div class="container">
      <span class="status-pill" aria-label="Standalone Android app status">
        <span class="status-dot" aria-hidden="true"></span>
        Standalone app removed
      </span>
      <h1>
        XChat on Android:<br />
        <span class="text-gradient">Use the X app or chat.x.com.</span>
      </h1>
      <p class="lead text-secondary prose-body">
        The separate X Chat app left Google Play around <strong>{XCHAT_STANDALONE_APP_REMOVED_ON}</strong>.
        That listing now returns a 404. Open chat inside the X app, or use <strong>chat.x.com</strong> in the browser.
        Do not install an APK from another site.
      </p>
      <div class="cta-buttons">
        <a href={CHAT_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
          Open chat.x.com →
        </a>
        <a href="/web" class="btn btn-secondary btn-lg">
          Web setup guide
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== STATUS CARD ==================== -->
  <section class="section status-section">
    <div class="container">
      <div class="status-grid">
        <article class="status-card">
          <div class="status-icon" aria-hidden="true">📱</div>
          <h3>iOS Status</h3>
          <p class="status-value">Inside the X app</p>
          <p class="text-secondary">
            The separate App Store listing was removed around {XCHAT_STANDALONE_APP_REMOVED_ON}. Open chat in the X app.
          </p>
        </article>
        <article class="status-card">
          <div class="status-icon" aria-hidden="true">🤖</div>
          <h3>Android Status</h3>
          <p class="status-value">Inside the X app</p>
          <p class="text-secondary">
            The separate Play listing was removed around {XCHAT_STANDALONE_APP_REMOVED_ON}. Use the X app. Do not install an APK.
          </p>
        </article>
        <article class="status-card">
          <div class="status-icon" aria-hidden="true">🌐</div>
          <h3>Web Status</h3>
          <p class="status-value good">Live · Works on Android</p>
          <p class="text-secondary">
            <a href={CHAT_URL} target="_blank" rel="noopener noreferrer">chat.x.com</a> works in Chrome on Android right now.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== TIMELINE ==================== -->
  <section class="section timeline-section">
    <div class="container">
      <h2 class="section-title">Timeline: Where Things Stand</h2>
      <ol class="timeline">
        {timeline.map((t, i) => (
          <li class={`timeline-item ${i === timeline.length - 1 ? 'is-now' : ''}`}>
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-body">
              <div class="timeline-date">{t.date}</div>
              <h3>{t.label}</h3>
              <p class="text-secondary">{t.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ==================== FAKE APK WARNING ==================== -->
  <section class="section warning-section">
    <div class="container">
      <div class="warning-card">
        <div class="warning-head">
          <span class="warning-icon" aria-hidden="true">⚠️</span>
          <h2>Warning: Fake XChat APKs Still Circulate</h2>
        </div>
        <p class="text-secondary prose-body">
          The separate X Chat app is <strong>no longer on Google Play</strong>. People still search for "XChat APK",
          and scammers still publish <strong>fake "XChat.apk" files</strong>.
          These can contain malware, credential stealers, or crypto wallet drainers. There is no official APK to install.
        </p>
        <h3 class="warning-subhead">Red flags to watch for:</h3>
        <ul class="warning-list">
          {fakeApkRedFlags.map((flag) => <li>{flag}</li>)}
        </ul>
        <h3 class="warning-subhead">Other apps still use the name "XChat"</h3>
        <p class="text-secondary">
          An unrelated messenger built on the Nostr protocol also uses the name "XChat". It is not from X Corp.
          Do not install it as a substitute. Open chat in the X app, or use chat.x.com.
        </p>
        <div class="cta-buttons" style="justify-content: flex-start; margin-top: 1.5rem;">
          <a href={CHAT_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Open chat.x.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WORKAROUND ==================== -->
  <section class="section workaround-section">
    <div class="container">
      <h2 class="section-title">Prefer Not to Install? Use the Web</h2>
      <div class="workaround-grid">
        <div class="workaround-text">
          <p class="text-secondary prose-body">
            On Android, open chat in the X app, or use <strong>chat.x.com</strong> — a web messenger that works in Chrome or any modern browser and uses the same X account.
          </p>
          <ul class="checklist">
            <li>End-to-end encrypted (set passcode on first login)</li>
            <li>Syncs all XChat messages from any device</li>
            <li>Group chats and invite links work fully</li>
            <li>No download — bookmark or "Add to Home Screen" as PWA</li>
            <li>No APK risk, no third-party install</li>
          </ul>
          <div class="cta-buttons" style="justify-content: flex-start; margin-top: 1rem;">
            <a href="/web" class="btn btn-primary">Full Web Setup Guide</a>
            <a href={CHAT_URL} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Open chat.x.com</a>
          </div>
        </div>
        <div class="workaround-callout">
          <h3>What you give up vs a native app</h3>
          <ul class="parity-list">
            <li><span class="check">✓</span> Text messaging</li>
            <li><span class="check">✓</span> Group chats</li>
            <li><span class="check">✓</span> Invite links</li>
            <li><span class="check">✓</span> File sharing</li>
            <li><span class="check">✓</span> Disappearing messages</li>
            <li><span class="x">✗</span> Voice calls (app only)</li>
            <li><span class="x">✗</span> Video calls (app only)</li>
            <li><span class="x">✗</span> Native push notifications</li>
            <li><span class="x">✗</span> Screenshot blocking</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== NOTIFY ==================== -->
  <section class="section notify-section">
    <div class="container">
      <div class="notify-card">
        <h2>Stay updated</h2>
        <p class="text-secondary prose-body">
          If X changes how chat works on Android, we post it on Telegram. Two places to follow:
        </p>
        <div class="notify-options">
          <a href={XCHAT_TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener noreferrer" class="notify-option">
            <h3>Telegram Channel →</h3>
            <p>Read-only channel. Push alerts on every Android development.</p>
          </a>
          <a href={XCHAT_TELEGRAM_COMMUNITY_URL} target="_blank" rel="noopener noreferrer" class="notify-option">
            <h3>Telegram Community →</h3>
            <p>Discuss with other Android-waiting users, share what you find.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="section faq-section">
    <div class="container">
      <h2 class="section-title">Android FAQ</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p class="text-secondary" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .hero {
    text-align: center;
    padding-top: 4rem;
    padding-bottom: 1.5rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ff9966;
    margin-bottom: 1rem;
    padding: 0.4rem 0.875rem;
    border: 1px solid rgba(255, 153, 102, 0.35);
    border-radius: var(--radius-full);
    background: rgba(255, 153, 102, 0.05);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff9966;
    animation: pulse 2s infinite;
  }

  /* 已上线的绿色变体（覆盖默认橘色 pill） */
  .status-pill.status-live {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.35);
    background: rgba(74, 222, 128, 0.06);
  }

  .status-pill.status-live .status-dot {
    background: #4ade80;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero h1 {
    max-width: 720px;
    margin: 0 auto 1.25rem;
  }

  .lead {
    font-size: 1.125rem;
    max-width: 660px;
    margin: 0 auto 1.5rem;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
  }

  /* ---- Status Cards ---- */
  .status-section {
    padding-top: 2rem;
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .status-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    text-align: center;
  }

  .status-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .status-card h3 {
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .status-value {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .status-value.good { color: #4ade80; }
  .status-value.bad { color: #ff9966; }

  .status-card p:last-child {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* ---- Timeline ---- */
  .timeline-section {
    background: linear-gradient(180deg, transparent, rgba(29, 155, 240, 0.03), transparent);
  }

  .section-title {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    max-width: 720px;
    margin: 0 auto;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border);
  }

  .timeline-item {
    position: relative;
    padding-left: 2.5rem;
    padding-bottom: 1.5rem;
  }

  .timeline-dot {
    position: absolute;
    left: 4px;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 2px solid var(--border);
  }

  .timeline-item.is-now .timeline-dot {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(29, 155, 240, 0.15);
  }

  .timeline-date {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-light);
    margin-bottom: 0.25rem;
  }

  .timeline-body h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.375rem;
  }

  .timeline-body p {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* ---- Warning ---- */
  .warning-section {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .warning-card {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem;
    border: 1px solid rgba(255, 99, 71, 0.3);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, rgba(255, 99, 71, 0.06), transparent);
  }

  .warning-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .warning-icon {
    font-size: 1.75rem;
  }

  .warning-card h2 {
    margin: 0;
    color: #ff6347;
  }

  .warning-subhead {
    font-size: 1rem;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .warning-list {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  /* ---- Workaround ---- */
  .workaround-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    max-width: 920px;
    margin: 0 auto;
    align-items: start;
  }

  .checklist {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  .checklist li {
    padding: 0.4rem 0 0.4rem 1.5rem;
    position: relative;
    color: var(--text-secondary);
  }

  .checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .workaround-callout {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }

  .workaround-callout h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .parity-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9375rem;
  }

  .parity-list li {
    padding: 0.375rem 0;
    color: var(--text-secondary);
  }

  .parity-list .check {
    color: #4ade80;
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .parity-list .x {
    color: #ff6347;
    font-weight: 700;
    margin-right: 0.5rem;
  }

  /* ---- Notify ---- */
  .notify-section {
    background: var(--bg-card);
    border-top: 1px solid var(--border);
  }

  .notify-card {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-primary);
  }

  .notify-card h2 {
    margin-bottom: 0.75rem;
  }

  .notify-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .notify-option {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    text-decoration: none;
    text-align: left;
    transition: border-color 0.2s, transform 0.2s;
  }

  .notify-option:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .notify-option h3 {
    font-size: 1rem;
    margin-bottom: 0.375rem;
    color: var(--text-primary);
  }

  .notify-option p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ---- FAQ ---- */
  .faq-section {
    border-top: 1px solid var(--border);
  }

  .faq-list {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    list-style: none;
    padding-right: 1.5rem;
    position: relative;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--accent);
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .workaround-grid, .notify-options {
      grid-template-columns: 1fr;
    }
  }
</style>
