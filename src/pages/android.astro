---
/**
 * android.astro — XChat Android 下载 + 状态页
 *
 * 关键事实（截至 2026-07-08 核实）：
 * - XChat 安卓版已上线 Google Play（2026-06-29，官方 @chat 账号宣布）
 * - 包名 com.x.chat，开发者 X Corp；100K+ 下载，3.9★，1K+ 评价，分级 12+
 * - iOS 先行（2026-04-24），安卓晚约两个月
 * - 假冒 XChat.apk 仍在钓鱼站流传：务必只从 Google Play 安装
 * - 另有一个 Nostr 协议的同名 "XChat"（com.oxchat.lite），与 X Corp 无关
 * - chat.x.com 网页版仍可用，作为「不想装 app」的备选
 *
 * SEO 战略：捕获最大量级 Android 相关流量：
 * - "xchat android", "xchat for android", "xchat apk", "xchat android download"
 * - "is xchat available on android", "xchat android app", "xchat google play"
 *
 * 同时承担安全教育功能：引导用户走官方 Google Play，警告假冒 APK。
 */
import Layout from '../layouts/Layout.astro';
import {
  XCHAT_TELEGRAM_CHANNEL_URL,
  XCHAT_TELEGRAM_COMMUNITY_URL,
  XCHAT_ANDROID_PLAY_STORE_URL,
  XCHAT_ANDROID_LAUNCH_DISPLAY,
  XCHAT_ANDROID_DOWNLOADS,
  XCHAT_ANDROID_RATING,
  XCHAT_ANDROID_REVIEWS,
} from '../data/xchat';

const CHAT_URL = 'https://chat.x.com';
const PLAY_URL = XCHAT_ANDROID_PLAY_STORE_URL;

/* JSON-LD: Article + FAQPage */
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'XChat for Android Is Live — Official Google Play Download (2026)',
  description: `XChat for Android launched ${XCHAT_ANDROID_LAUNCH_DISPLAY} on Google Play (com.x.chat, by X Corp). Download the official app, avoid fake APKs, and see how the Android version compares to iOS.`,
  author: { '@type': 'Organization', name: 'XChat Hub' },
  publisher: { '@type': 'Organization', name: 'XChat Hub', url: 'https://xchat.directory' },
  datePublished: '2026-04-24',
  dateModified: new Date().toISOString().split('T')[0],
};

const timeline = [
  { date: 'May 2025',     label: 'Internal beta',       desc: 'X starts internal testing of XChat with employees and select beta users.' },
  { date: 'Dec 2025',     label: 'chat.x.com launches', desc: 'X quietly releases a standalone web version at chat.x.com — accessible from any browser including Android.' },
  { date: 'Mar 2026',     label: 'Public iOS beta',     desc: 'XChat enters public TestFlight beta on iOS. No Android beta yet.' },
  { date: 'Apr 24, 2026', label: 'iOS public launch',   desc: 'XChat officially launches on the Apple App Store for iPhone and iPad.' },
  { date: 'May 27, 2026', label: 'Android pre-registration', desc: 'X opens Google Play pre-registration for the Android version of XChat.' },
  { date: 'Jun 29, 2026', label: 'Android public launch', desc: 'XChat for Android goes live on Google Play (com.x.chat, by X Corp) — announced on the official @chat account.' },
];

const fakeApkRedFlags = [
  'Domain is not x.com or apple.com',
  'Asks you to enable "Install from Unknown Sources"',
  'Requests permissions that messaging apps don\'t need (SMS, contacts export, accessibility services)',
  'Has a slightly different name like "XChat Pro", "XChat+", "X Chat Plus"',
  'Promises "early access" or "leaked version"',
  'Has very few or only 5-star reviews on the source site',
];

const faqs = [
  {
    q: 'Is XChat available on Android?',
    a: `<strong>Yes.</strong> XChat for Android launched ${XCHAT_ANDROID_LAUNCH_DISPLAY} and is available now on <a href="${PLAY_URL}" target="_blank" rel="noopener noreferrer">Google Play</a>. The official listing is published by <strong>X Corp</strong> (package <code>com.x.chat</code>) and the app is free.`,
  },
  {
    q: 'What is the official XChat Android download link?',
    a: `The only official source is the Google Play listing by X Corp: <a href="${PLAY_URL}" target="_blank" rel="noopener noreferrer">play.google.com/store/apps/details?id=com.x.chat</a>. Do not download "XChat.apk" from any other website.`,
  },
  {
    q: 'Should I download an XChat APK from a third-party site?',
    a: '<strong>No.</strong> Now that the official app is on Google Play, there is no reason to sideload an APK. Sites offering "XChat.apk" are unnecessary and often bundle malware or credential stealers. Install from Google Play only.',
  },
  {
    q: 'There are several apps called "XChat" on Google Play. Which is the real one?',
    a: 'The official X Corp app is <strong>developer "X Corp." with package <code>com.x.chat</code></strong>. A separate, unrelated "XChat" built on the Nostr protocol (<code>com.oxchat.lite</code>) also exists — it is <strong>not</strong> from X Corp. Always check the developer name before installing.',
  },
  {
    q: 'Do my XChat messages sync across iOS, Android, and Web?',
    a: 'Yes. All XChat surfaces (iOS app, Android app, chat.x.com web, and the main X app) share the same X account backend. Log in once and your messages, groups, and contacts appear everywhere.',
  },
  {
    q: 'Can I use XChat on Android without installing the app?',
    a: `Yes. <a href="${CHAT_URL}" target="_blank" rel="noopener noreferrer">chat.x.com</a> works in Chrome or any mobile browser and syncs the same account — a good option if you prefer not to install. The native app adds push notifications and a smoother mobile experience.`,
  },
  {
    q: 'Did XChat launch on iOS before Android?',
    a: 'Yes. XChat launched on the Apple App Store on April 24, 2026, and the Android version followed on Google Play on June 29, 2026 — roughly two months later.',
  },
  {
    q: 'Does the Android version cost money?',
    a: 'No. XChat is free on both Android and iOS, with no ads. An X (formerly Twitter) account is required to sign in.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a.replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<Layout
  title="XChat for Android — Official Google Play Download (2026)"
  description="XChat for Android is live on Google Play (launched June 29, 2026, by X Corp). Get the official download link and listing details, and learn how to avoid fake APKs."
  jsonLd={[articleJsonLd, faqJsonLd]}
  canonicalPath="/android"
  breadcrumbs={[
    { name: 'Home', url: 'https://xchat.directory/' },
    { name: 'XChat for Android', url: 'https://xchat.directory/android/' },
  ]}
>
  <!-- ==================== HERO ==================== -->
  <section class="section hero">
    <div class="container">
      <span class="status-pill status-live" aria-label="Android release status">
        <span class="status-dot" aria-hidden="true"></span>
        Live on Google Play
      </span>
      <h1>
        XChat for Android:<br />
        <span class="text-gradient">Now Live on Google Play.</span>
      </h1>
      <p class="lead text-secondary prose-body">
        XChat for Android launched <strong>{XCHAT_ANDROID_LAUNCH_DISPLAY}</strong>. Download the official app free
        from Google Play (by X Corp, <code>com.x.chat</code>) — end-to-end encrypted, sign in with your X account.
        Below: the verified listing details, plus how to avoid fake APKs.
      </p>
      <div class="cta-buttons">
        <a href={PLAY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
          Download on Google Play →
        </a>
        <a href={CHAT_URL} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">
          Use chat.x.com (no install)
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== STATUS CARD ==================== -->
  <section class="section status-section">
    <div class="container">
      <div class="status-grid">
        <article class="status-card">
          <div class="status-icon" aria-hidden="true">📱</div>
          <h3>iOS Status</h3>
          <p class="status-value good">Live since April 24, 2026</p>
          <p class="text-secondary">
            Available on iPhone &amp; iPad, requires iOS 26+.
          </p>
        </article>
        <article class="status-card">
          <div class="status-icon" aria-hidden="true">🤖</div>
          <h3>Android Status</h3>
          <p class="status-value good">Live since {XCHAT_ANDROID_LAUNCH_DISPLAY}</p>
          <p class="text-secondary">
            On <a href={PLAY_URL} target="_blank" rel="noopener noreferrer">Google Play</a> (com.x.chat).
            {XCHAT_ANDROID_DOWNLOADS} downloads · {XCHAT_ANDROID_RATING}★ ({XCHAT_ANDROID_REVIEWS} ratings).
          </p>
        </article>
        <article class="status-card">
          <div class="status-icon" aria-hidden="true">🌐</div>
          <h3>Web Status</h3>
          <p class="status-value good">Live · Works on Android</p>
          <p class="text-secondary">
            <a href={CHAT_URL} target="_blank" rel="noopener noreferrer">chat.x.com</a> works in Chrome on Android right now.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== TIMELINE ==================== -->
  <section class="section timeline-section">
    <div class="container">
      <h2 class="section-title">Timeline: Where Things Stand</h2>
      <ol class="timeline">
        {timeline.map((t, i) => (
          <li class={`timeline-item ${i === timeline.length - 1 ? 'is-now' : ''}`}>
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-body">
              <div class="timeline-date">{t.date}</div>
              <h3>{t.label}</h3>
              <p class="text-secondary">{t.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ==================== FAKE APK WARNING ==================== -->
  <section class="section warning-section">
    <div class="container">
      <div class="warning-card">
        <div class="warning-head">
          <span class="warning-icon" aria-hidden="true">⚠️</span>
          <h2>Warning: Fake XChat APKs Still Circulate</h2>
        </div>
        <p class="text-secondary prose-body">
          XChat now has an <strong>official Android app on Google Play</strong> — but because so many people still
          search for "XChat APK", scammers keep publishing <strong>fake "XChat.apk" files</strong> on phishing sites.
          These can contain malware, credential stealers, or crypto wallet drainers. Only install from Google Play.
        </p>
        <h3 class="warning-subhead">Red flags to watch for:</h3>
        <ul class="warning-list">
          {fakeApkRedFlags.map((flag) => <li>{flag}</li>)}
        </ul>
        <h3 class="warning-subhead">Not every "XChat" on Google Play is the X Corp app</h3>
        <p class="text-secondary">
          The official app is published by <strong>X Corp</strong> (package <code>com.x.chat</code>). A separate,
          unrelated messenger built on the Nostr protocol also uses the "XChat" name (<code>com.oxchat.lite</code>).
          Before installing, confirm the developer is <strong>"X Corp."</strong> — that is the only legitimate listing.
        </p>
        <div class="cta-buttons" style="justify-content: flex-start; margin-top: 1.5rem;">
          <a href={PLAY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Get the Official App on Google Play
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WORKAROUND ==================== -->
  <section class="section workaround-section">
    <div class="container">
      <h2 class="section-title">Prefer Not to Install? Use the Web</h2>
      <div class="workaround-grid">
        <div class="workaround-text">
          <p class="text-secondary prose-body">
            The Google Play app is the recommended way to use XChat on Android. But if you'd rather not install anything,
            X also runs <strong>chat.x.com</strong> — a standalone web messenger that works in Chrome or any modern browser and syncs the same account.
          </p>
          <ul class="checklist">
            <li>End-to-end encrypted (set passcode on first login)</li>
            <li>Syncs all XChat messages from any device</li>
            <li>Group chats and invite links work fully</li>
            <li>No download — bookmark or "Add to Home Screen" as PWA</li>
            <li>No APK risk, no third-party install</li>
          </ul>
          <div class="cta-buttons" style="justify-content: flex-start; margin-top: 1rem;">
            <a href="/web" class="btn btn-primary">Full Web Setup Guide</a>
            <a href={CHAT_URL} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Open chat.x.com</a>
          </div>
        </div>
        <div class="workaround-callout">
          <h3>What you give up vs a native app</h3>
          <ul class="parity-list">
            <li><span class="check">✓</span> Text messaging</li>
            <li><span class="check">✓</span> Group chats</li>
            <li><span class="check">✓</span> Invite links</li>
            <li><span class="check">✓</span> File sharing</li>
            <li><span class="check">✓</span> Disappearing messages</li>
            <li><span class="x">✗</span> Voice calls (app only)</li>
            <li><span class="x">✗</span> Video calls (app only)</li>
            <li><span class="x">✗</span> Native push notifications</li>
            <li><span class="x">✗</span> Screenshot blocking</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== NOTIFY ==================== -->
  <section class="section notify-section">
    <div class="container">
      <div class="notify-card">
        <h2>Get the Android Release Alert First</h2>
        <p class="text-secondary prose-body">
          When X publishes anything about Android — beta, TestFlight-equivalent, Google Play listing, or general availability —
          we post it the same day. Two ways to stay updated:
        </p>
        <div class="notify-options">
          <a href={XCHAT_TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener noreferrer" class="notify-option">
            <h3>Telegram Channel →</h3>
            <p>Read-only channel. Push alerts on every Android development.</p>
          </a>
          <a href={XCHAT_TELEGRAM_COMMUNITY_URL} target="_blank" rel="noopener noreferrer" class="notify-option">
            <h3>Telegram Community →</h3>
            <p>Discuss with other Android-waiting users, share what you find.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="section faq-section">
    <div class="container">
      <h2 class="section-title">Android FAQ</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p class="text-secondary" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .hero {
    text-align: center;
    padding-top: 4rem;
    padding-bottom: 1.5rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ff9966;
    margin-bottom: 1rem;
    padding: 0.4rem 0.875rem;
    border: 1px solid rgba(255, 153, 102, 0.35);
    border-radius: var(--radius-full);
    background: rgba(255, 153, 102, 0.05);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff9966;
    animation: pulse 2s infinite;
  }

  /* 已上线的绿色变体（覆盖默认橘色 pill） */
  .status-pill.status-live {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.35);
    background: rgba(74, 222, 128, 0.06);
  }

  .status-pill.status-live .status-dot {
    background: #4ade80;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero h1 {
    max-width: 720px;
    margin: 0 auto 1.25rem;
  }

  .lead {
    font-size: 1.125rem;
    max-width: 660px;
    margin: 0 auto 1.5rem;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
  }

  /* ---- Status Cards ---- */
  .status-section {
    padding-top: 2rem;
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .status-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    text-align: center;
  }

  .status-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .status-card h3 {
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .status-value {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .status-value.good { color: #4ade80; }
  .status-value.bad { color: #ff9966; }

  .status-card p:last-child {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* ---- Timeline ---- */
  .timeline-section {
    background: linear-gradient(180deg, transparent, rgba(29, 155, 240, 0.03), transparent);
  }

  .section-title {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    max-width: 720px;
    margin: 0 auto;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border);
  }

  .timeline-item {
    position: relative;
    padding-left: 2.5rem;
    padding-bottom: 1.5rem;
  }

  .timeline-dot {
    position: absolute;
    left: 4px;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 2px solid var(--border);
  }

  .timeline-item.is-now .timeline-dot {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(29, 155, 240, 0.15);
  }

  .timeline-date {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-light);
    margin-bottom: 0.25rem;
  }

  .timeline-body h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.375rem;
  }

  .timeline-body p {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* ---- Warning ---- */
  .warning-section {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .warning-card {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem;
    border: 1px solid rgba(255, 99, 71, 0.3);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, rgba(255, 99, 71, 0.06), transparent);
  }

  .warning-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .warning-icon {
    font-size: 1.75rem;
  }

  .warning-card h2 {
    margin: 0;
    color: #ff6347;
  }

  .warning-subhead {
    font-size: 1rem;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .warning-list {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  /* ---- Workaround ---- */
  .workaround-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    max-width: 920px;
    margin: 0 auto;
    align-items: start;
  }

  .checklist {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  .checklist li {
    padding: 0.4rem 0 0.4rem 1.5rem;
    position: relative;
    color: var(--text-secondary);
  }

  .checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .workaround-callout {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }

  .workaround-callout h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .parity-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9375rem;
  }

  .parity-list li {
    padding: 0.375rem 0;
    color: var(--text-secondary);
  }

  .parity-list .check {
    color: #4ade80;
    font-weight: 700;
    margin-right: 0.5rem;
  }

  .parity-list .x {
    color: #ff6347;
    font-weight: 700;
    margin-right: 0.5rem;
  }

  /* ---- Notify ---- */
  .notify-section {
    background: var(--bg-card);
    border-top: 1px solid var(--border);
  }

  .notify-card {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-primary);
  }

  .notify-card h2 {
    margin-bottom: 0.75rem;
  }

  .notify-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .notify-option {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    text-decoration: none;
    text-align: left;
    transition: border-color 0.2s, transform 0.2s;
  }

  .notify-option:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .notify-option h3 {
    font-size: 1rem;
    margin-bottom: 0.375rem;
    color: var(--text-primary);
  }

  .notify-option p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ---- FAQ ---- */
  .faq-section {
    border-top: 1px solid var(--border);
  }

  .faq-list {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    list-style: none;
    padding-right: 1.5rem;
    position: relative;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--accent);
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
