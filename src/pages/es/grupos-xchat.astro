---
/**
 * es/grupos-xchat.astro — grupos de XChat en español
 *
 * SEO：Search Console 里 "grupos xchat" 有展示，但落在英文 /groups（平均排名约 27）。
 * 这一页用西班牙语回答同一个意图：grupos xchat / grupos de XChat。
 * 群名、描述和邀请链接只来自 src/data/groups.ts，不手写、不编造。
 */
import Layout from '../../layouts/Layout.astro';
import { XCHAT_IOS_REQUIREMENT } from '../../data/xchat';
import { GROUP_CATEGORY_META } from '../../data/groupCategoryMeta';
import {
  GROUP_DIRECTORY_ALTERNATES,
  SORTED_GROUP_DIRECTORY,
  formatVerifiedOn,
} from '../../data/groups';

const groups = SORTED_GROUP_DIRECTORY;
const listedCount = groups.length;
const dateModified = '2026-10-20';
const updatedLabel = formatVerifiedOn(dateModified, 'es');

const CATEGORY_ES: Record<string, string> = {
  Crypto: 'Cripto',
  Tech: 'Tecnología',
  AI: 'IA',
  News: 'Noticias',
  Sports: 'Deportes',
  Gaming: 'Videojuegos',
  Business: 'Negocios',
  Entertainment: 'Entretenimiento',
  Education: 'Educación',
  Local: 'Local',
  Other: 'Otros',
};

const categoryByLabel = new Map(GROUP_CATEGORY_META.map((category) => [category.label, category]));

const faqs = [
  {
    q: '¿Dónde encuentro grupos de XChat?',
    a: `XChat no tiene un buscador de grupos dentro de la app. Los grupos XChat con enlace público comprobado están en esta página y en el <a href="/groups">directorio</a>. Ahora hay ${listedCount}.`,
  },
  {
    q: '¿Estos grupos de XChat están inventados?',
    a: 'No. Un grupo solo se publica si el enlace es público, alguien lo abrió y el tema es una comunidad normal. «Verificado el» es el día de esa comprobación, no una promesa de que el grupo siga abierto.',
  },
  {
    q: '¿Hace falta X Premium para unirse?',
    a: 'No. XChat es gratis y unirse a un grupo público no exige una suscripción.',
  },
  {
    q: '¿Puedo añadir mi grupo?',
    a: 'Sí. Crea el enlace público con la <a href="/how-to-create-group-link">guía de enlaces</a> y envíalo desde <a href="/list-your-group">la página de envío</a>. La inclusión es gratis; no hay puestos de pago.',
  },
];

const pageDescription = 'Grupos de XChat con enlaces públicos ya comprobados. Solo aparecen grupos cuyo enlace alguien abrió y verificó. Mira cómo unirte o envía el tuyo.';

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Grupos de XChat',
  description: pageDescription,
  inLanguage: 'es',
  dateModified,
  url: 'https://xchat.directory/es/grupos-xchat',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: listedCount,
    itemListElement: groups.map((group, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: group.name,
      url: group.inviteUrl,
    })),
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'es',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<Layout
  title="Grupos XChat — grupos de XChat con enlaces reales"
  description={pageDescription}
  jsonLd={collectionJsonLd}
  canonicalPath="/es/grupos-xchat"
  ogImage="/og-groups.png"
  ogImageAlt="Grupos de XChat con enlaces reales — xchat.directory"
  lang="es"
  alternates={[...GROUP_DIRECTORY_ALTERNATES]}
  breadcrumbs={[
    { name: 'Home', url: 'https://xchat.directory/' },
    { name: 'Grupos de XChat', url: 'https://xchat.directory/es/grupos-xchat' },
  ]}
>
  <article>
    <section class="section hero">
      <div class="container">
        <span class="eyebrow">Español · {updatedLabel}</span>
        <h1>Grupos de XChat</h1>
        <p class="lead text-secondary prose-body">
          {listedCount > 0 ? (
            <>
              ¿Buscas grupos XChat? Aquí están los grupos de XChat con un enlace público que ya está en el directorio.
              Ahora hay {listedCount}. Alguien abrió cada enlace y anotó la fecha.
              El listado en inglés está en el <a href="/groups">directorio de grupos</a>.
            </>
          ) : (
            <>
              ¿Buscas grupos XChat? El directorio todavía no tiene grupos de XChat con un enlace comprobado.
              Esta página no publica nombres ni enlaces que no estén en los datos del sitio.
              Cuando se verifique uno, aparecerá aquí y en el <a href="/groups">directorio</a>.
            </>
          )}
        </p>
        {listedCount > 0 && (
          <div class="cta-buttons">
            <a href="#listados" class="btn btn-primary btn-lg">Ver grupos listados</a>
          </div>
        )}
      </div>
    </section>

    <section class="section-sm" id="listados">
      <div class="container">
        <h2 class="section-title">Grupos XChat listados</h2>
        {listedCount > 0 ? (
          <>
            <p class="section-intro text-secondary prose-body">
              Solo estos grupos están publicados. El nombre, la descripción y el enlace salen de los datos del sitio.
            </p>
            <div class="group-list">
              {groups.map((group) => {
                const category = categoryByLabel.get(group.category);
                const categoryLabel = CATEGORY_ES[group.category] ?? group.category;
                return (
                  <article class="group-card">
                    <h3>{group.name}</h3>
                    <p class="group-meta text-muted">
                      {category ? (
                        <a href={`/groups/${category.slug}/`}>{categoryLabel}</a>
                      ) : (
                        <span>{categoryLabel}</span>
                      )}
                      <span aria-hidden="true">·</span>
                      <time datetime={group.verifiedAt}>Verificado el {formatVerifiedOn(group.verifiedAt, 'es')}</time>
                      {group.members > 0 && (
                        <>
                          <span aria-hidden="true">·</span>
                          <span>{group.members} miembros</span>
                        </>
                      )}
                    </p>
                    <p class="group-desc text-secondary">{group.description}</p>
                    <a href={group.inviteUrl} class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer nofollow">
                      Unirse
                    </a>
                  </article>
                );
              })}
            </div>
          </>
        ) : (
          <p class="section-intro text-secondary prose-body">
            No hay grupos listados. <a href="/list-your-group">Envía un enlace público</a> si administras uno.
          </p>
        )}
      </div>
    </section>

    <section class="section-sm">
      <div class="container">
        <div class="tldr-card">
          <h2>Cómo unirse a un grupo de XChat</h2>
          <ol>
            <li>Usa un enlace que empiece por <code>https://x.com/i/chat/group_join/</code>. Otros formatos no son enlaces de grupo de XChat.</li>
            <li>Ábrelo en un iPhone o iPad con XChat ({XCHAT_IOS_REQUIREMENT}), en la app de Android o en el navegador, en <a href="/web">chat.x.com</a>.</li>
            <li>Pulsa “Request to Join”. XChat muestra el nombre del grupo antes de enviar la solicitud.</li>
            <li>Espera a que un administrador la apruebe. El grupo aparece en la bandeja cuando te aceptan.</li>
          </ol>
          <p class="text-secondary">
            Si el enlace no abre, la <a href="/how-to-join-xchat-group">guía en inglés</a> recoge los fallos más habituales.
          </p>
        </div>
      </div>
    </section>

    <section class="section-sm">
      <div class="container">
        <div class="callout callout-warning">
          <strong>Cuidado:</strong> un grupo real de XChat no pasa por un acortador ni pide la contraseña de X. Unirte nunca requiere la contraseña.
        </div>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="container">
        <h2 class="section-title">Preguntas frecuentes</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p class="text-secondary" set:html={faq.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section related-section">
      <div class="container">
        <h2 class="section-title">Siguiente</h2>
        <div class="related-grid">
          <a href="/groups" class="related-card" hreflang="en"><h3>Directorio en inglés →</h3><p class="text-secondary">Los mismos grupos, con búsqueda y categorías.</p></a>
          <a href="/how-to-join-xchat-group" class="related-card"><h3>Cómo unirse →</h3><p class="text-secondary">Guía detallada, en inglés.</p></a>
          <a href="/zh/xchat-groups" class="related-card" hreflang="zh-CN" lang="zh-CN"><h3>XChat 群组指南 →</h3><p class="text-secondary">La misma explicación, en chino.</p></a>
          <a href="/list-your-group" class="related-card"><h3>Enviar tu grupo →</h3><p class="text-secondary">Inclusión gratis, con revisión manual.</p></a>
        </div>
      </div>
    </section>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>

<style>
  .hero {
    text-align: center;
    padding-top: 4rem;
    padding-bottom: 2rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-light);
    margin-bottom: 1rem;
    padding: 0.3125rem 0.875rem;
    border: 1px solid rgba(29, 155, 240, 0.25);
    border-radius: var(--radius-full);
    background: rgba(29, 155, 240, 0.05);
  }

  .hero h1 {
    max-width: 820px;
    margin: 0 auto 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .lead,
  .section-intro {
    font-size: 1.0625rem;
    max-width: 720px;
    margin: 0 auto 1.5rem;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
  }

  .section-title {
    text-align: center;
    margin-bottom: 1rem;
  }

  .group-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .group-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-card);
  }

  .group-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.375rem;
  }

  .group-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .group-meta a {
    color: var(--accent-light);
  }

  .group-desc {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .tldr-card {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-card);
  }

  .tldr-card h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .tldr-card ol {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.85;
  }

  .tldr-card li + li {
    margin-top: 0.375rem;
  }

  .tldr-card code {
    background: rgba(29, 155, 240, 0.08);
    color: var(--accent-light);
    padding: 0.1em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .callout {
    max-width: 760px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid;
  }

  .callout-warning {
    background: rgba(245, 197, 24, 0.06);
    border-color: rgba(245, 197, 24, 0.25);
    color: #f5c518;
  }

  .faq-section {
    border-top: 1px solid var(--border);
  }

  .faq-list {
    max-width: 760px;
    margin: 0 auto;
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq-item p {
    margin-top: 0.75rem;
    line-height: 1.7;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: block;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .related-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .related-card h3 {
    color: var(--text-primary);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .related-card p {
    font-size: 0.875rem;
    margin: 0;
  }
</style>
