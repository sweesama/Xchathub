---
/**
 * compare/signal-vs-threema.astro
 *
 * 高价值 SEO 词：signal vs threema, threema vs signal, threema signal comparison
 * 目标搜索意图：用户已经研究完加密通信，正在两个主流 app 里选
 *
 * 设计原则：
 *  - 维度对比表（横向 11+ 行对比）
 *  - 谁适合谁（"pick 卡片"）
 *  - 决策树 ("如果你是 X，你选 Y"）
 *  - 真实缺点都说（不吹捧）
 */
import Layout from '../../layouts/Layout.astro';
import {
  getAppBySlug,
  formatPlatforms,
} from '../../data/messagingApps';
import {
  articleJsonLd,
  faqPageJsonLd,
  graphJsonLd,
} from '../../lib/structuredData';
import AdSlot from '../../components/AdSlot.astro';

const a = getAppBySlug('signal');
const b = getAppBySlug('threema');
if (!a || !b) throw new Error('Comparison data missing');

// 11 维对比行：(label, [a, b])
const rows: { label: string; a: string; b: string; winner: 'a' | 'b' | null }[] = [
  { label: 'Founded', a: '2014', b: '2012', winner: null },
  { label: 'Owner', a: 'Signal Foundation (US)', b: 'Threema GmbH (Switzerland)', winner: null },
  { label: 'Business model', a: 'Free, donation-funded nonprofit', b: 'One-time payment ($4.49)', winner: null },
  { label: 'Phone number required', a: 'Yes (with username option since 2024)', b: 'No — register with random ID', winner: 'b' },
  { label: 'Email required', a: 'No', b: 'No', winner: null },
  { label: 'End-to-end encryption', a: 'Default (Signal Protocol)', b: 'Default (NaCl/libsodium)', winner: null },
  { label: 'Open source', a: 'Yes — clients and server', b: 'Yes — clients (server source available for review)', winner: null },
  { label: 'Independent audits', a: 'Multiple, ongoing, publicly released', b: 'External review, all apps open source', winner: null },
  { label: 'Platforms', a: formatPlatforms(a), b: formatPlatforms(b), winner: null },
  { label: 'Group size limit', a: '1,000 members', b: '256 members', winner: 'a' },
  { label: 'Voice / video calls (E2EE)', a: 'Yes', b: 'Yes', winner: null },
  { label: 'Voice / video group calls', a: 'Yes (up to 50 people)', b: 'Yes (Threema calls)', winner: null },
  { label: 'Disappearing messages', a: 'Yes, custom timers', b: 'Yes', winner: null },
  { label: 'Approximate monthly users', a: '~70 million', b: '~1 million', winner: 'a' },
  { label: 'Advertising/tracking', a: 'None', b: 'None', winner: null },
  { label: 'Server location', a: 'United States', b: 'Switzerland (FDPIC jurisdiction)', winner: null },
];

const stFaqs = [
  {
    question: 'Is Signal more private than Threema?',
    answer: 'Both Signal and Threema are end-to-end encrypted by default and use open-source, audited cryptography. Signal collects minimal metadata (phone number, day joined, last connection) and is donation-funded as a 501(c)(3) nonprofit. Threema collects no personal identifiers at all (no phone, no email) and is hosted in Switzerland. Threema is technically more private because it has zero identifiers; Signal is more private in practice because of its larger user base (more people to talk to).',
  },
  {
    question: 'Does Threema work without a phone number?',
    answer: 'Yes. Threema is the best-known messenger that lets you register with a random Threema ID only — no phone number and no email required. You can pay the one-time $4.49 fee anonymously. Signal, by contrast, still requires a phone number at registration (though since 2024 you can hide it behind a username).',
  },
  {
    question: 'Can I use Signal and Threema together?',
    answer: 'No. Signal and Threema are separate networks with separate user bases. You can install both apps and use each with their respective users, but they cannot message each other. If your contacts are mostly on Signal, use Signal. If you need anonymous accounts and most of your contacts are privacy-focused, Threema is the better fit.',
  },
  {
    question: 'Which is more secure: Signal or Threema?',
    answer: 'Both are top-tier on security. Signal uses the Signal Protocol (Double Ratchet), is open source, and is audited by multiple independent firms annually. Threema uses NaCl/libsodium with open-source clients and reviewed server code. The difference is threat model: Signal is more battle-tested at scale (used by journalists, activists, governments); Threema is hosted in Switzerland under FDPIC jurisdiction, which some users prefer for legal protection.',
  },
];

const jsonLd = graphJsonLd(
  articleJsonLd({
    headline: 'Signal vs Threema (2026) — Which Encrypted Messenger Should You Use?',
    description: 'Detailed Signal vs Threema comparison covering privacy, encryption, costs, ownership, and real-world use cases. Both are audited and open source — the choice comes down to your threat model.',
    datePublished: '2026-05-15',
    dateModified: '2026-07-08',
    url: '/compare/signal-vs-threema',
  }),
  faqPageJsonLd(stFaqs),
);

const breadcrumbs = [
  { name: 'Home', url: 'https://xchat.directory/' },
  { name: 'Compare', url: 'https://xchat.directory/reviews/' },
  { name: 'Signal vs Threema', url: 'https://xchat.directory/compare/signal-vs-threema/' },
];
---

<Layout
  title="Signal vs Threema (2026) — Free vs Paid, Both Private"
  description="Signal vs Threema on encryption, audits, ownership, cost. Both are top-tier encrypted messengers — who should pay for Threema."
  jsonLd={jsonLd}
  canonicalPath="/compare/signal-vs-threema"
  breadcrumbs={breadcrumbs}
  ogImageAlt="Signal vs Threema comparison"
>
  <article class="compare">
    <!-- ============== HERO ============== -->
    <section class="compare-hero">
      <div class="container">
        <nav class="breadcrumb text-muted" aria-label="Breadcrumb">
          <a href="/">Home</a> <span class="crumb-sep">/</span>
          <a href="/reviews/">Compare</a> <span class="crumb-sep">/</span>
          <span>Signal vs Threema</span>
        </nav>

        <div class="hero-vs">
          <div class="vs-side vs-a">
            <span class="vs-monogram" style={`background:${a.brandColor}`}>{a.monogram}</span>
            <div class="vs-name">{a.name}</div>
            <div class="vs-score">{a.editorScore.toFixed(1)} <span class="score-out">/ 10</span></div>
          </div>
          <div class="vs-divider"><span>vs</span></div>
          <div class="vs-side vs-b">
            <span class="vs-monogram" style={`background:${b.brandColor}`}>{b.monogram}</span>
            <div class="vs-name">{b.name}</div>
            <div class="vs-score">{b.editorScore.toFixed(1)} <span class="score-out">/ 10</span></div>
          </div>
        </div>

        <h1>Signal vs Threema: <span class="text-gradient">Two Privacy Champions, Different Philosophies</span></h1>
        <p class="lead text-secondary prose-body">
          Signal and Threema are the two best encrypted messengers in 2026. Both are open-source, both
          end-to-end encrypt by default, and both have been audited. The difference comes down to
          business model (nonprofit vs paid) and identity (phone number vs random ID). This page
          breaks down exactly where each one wins.
        </p>
      </div>
    </section>

    <!-- ============== COMPARISON TABLE ============== -->
    <section class="section-sm">
      <div class="container">
        <h2 class="section-title">Side-by-side comparison</h2>
        <div class="table-wrap">
          <table class="cmp-table">
            <thead>
              <tr>
                <th>Dimension</th>
                <th class="col-a">{a.name}</th>
                <th class="col-b">{b.name}</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td class="cmp-label">{row.label}</td>
                  <td class={`col-a${row.winner === 'a' ? ' col-win' : ''}`}>
                    {row.winner === 'a' && <span class="winner-mark" aria-label="Winner">★</span>}
                    {row.a}
                  </td>
                  <td class={`col-b${row.winner === 'b' ? ' col-win' : ''}`}>
                    {row.winner === 'b' && <span class="winner-mark" aria-label="Winner">★</span>}
                    {row.b}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="cmp-note text-muted">
          ★ marks the dimension where one app clearly wins.<br />
          Data sources: <a href={a.sources[0]?.url} target="_blank" rel="noopener noreferrer">{a.name} official</a>, <a href={b.sources[0]?.url} target="_blank" rel="noopener noreferrer">{b.name} official</a>, signal.org/threema.ch websites, apps reviewed July 8, 2026.
        </p>

        <AdSlot slot="compare-mid" label="Sponsored" />
      </div>
    </section>

    <!-- ============== PICK CARDS ============== -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Who should pick which</h2>
        <div class="pick-grid">
          <article class="pick-card pick-a">
            <header>
              <span class="pick-monogram" style={`background:${a.brandColor}`}>{a.monogram}</span>
              <h3>Choose Signal if…</h3>
            </header>
            <ul>
              <li>You have a phone number and don't mind giving it to one more service</li>
              <li>You want the largest user base among privacy-first messengers (~70 million)</li>
              <li>You're a journalist, activist, lawyer, or anyone whose safety may depend on a non-commercial organization</li>
              <li>You want free (no $4 upfront cost)</li>
              <li>You need to send messages to people who don't have Threema installed</li>
            </ul>
            <a href="/reviews/signal/" class="pick-cta">Read full Signal review →</a>
          </article>

          <article class="pick-card pick-b">
            <header>
              <span class="pick-monogram" style={`background:${b.brandColor}`}>{b.monogram}</span>
              <h3>Choose Threema if…</h3>
            </header>
            <ul>
              <li>You don't want to give any phone number or email — you want full anonymity from day one</li>
              <li>You're in Europe, especially DACH (Germany / Austria / Switzerland)</li>
              <li>You'd rather pay once ($4) for a small commercial product than rely on donations</li>
              <li>You prefer your data stored under Swiss jurisdiction (FDPIC) rather than US</li>
              <li>You want a clean app without needing to grow via viral signups</li>
            </ul>
            <a href="/reviews/threema/" class="pick-cta">Read full Threema review →</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ============== LONGFORM PROSE ============== -->
    <section class="section">
      <div class="container">
        <div class="prose">
          <h2>The privacy comparison that matters most</h2>
          <p>
            Both Signal and Threema are at the top of any honest encrypted messenger ranking, but the way
            they protect your privacy is different. Understanding this lets you pick the one whose
            trade-offs match your threat model.
          </p>

          <h3>Encryption: tied</h3>
          <p>
            Both apps run end-to-end encryption by default, on every chat, voice call, and video call.
            Signal uses the <strong>Signal Protocol (Double Ratchet)</strong> — the same algorithm
            WhatsApp and Google Messages use under licence. Threema uses its own <strong>NaCl / libsodium-based
            protocol</strong>, which is open source and externally audited. Neither has a known backdoor.
            For pure transport security, you're equally covered by either.
          </p>

          <h3>Identity: this is the real fork</h3>
          <p>
            Signal still requires a <strong>phone number</strong> at signup. Since 2024 you can layer a
            username on top, but the underlying account is bound to a real number. For most people this
            is fine — your friends already have your number.
          </p>
          <p>
            Threema takes the opposite path: <strong>no phone, no email</strong>. You generate a random
            Threema ID at install time, and that's your identity. This is closer to how privacy tools
            like ProtonMail work — the operator has nothing to hand over to authorities even if asked.
          </p>
          <p>
            If your threat model includes governments that can subpoena phone carriers, Threema's no-number
            design is materially stronger. If your threat model is "I don't want my messages to leak,"
            either app does the job.
          </p>

          <h3>Business model: nonprofit vs paid</h3>
          <p>
            Signal is run by the nonprofit <strong>Signal Foundation</strong>. It's free for everyone,
            funded by donations, including tens of millions from Brian Acton personally. Threema is run
            by <strong>Threema GmbH</strong>, a Swiss company, and earns its keep by charging a small
            one-time fee (~USD 4.49) instead of showing ads or selling data.
          </p>
          <p>
            Both models have honesty advantages. Signal has no commercial pressure to monetize; Threema
            has no donation-cycle pressure to chase growth. Neither has an "evil business model" — you
            just pick the one that fits your politics.
          </p>

          <h3>Open source: tied again</h3>
          <p>
            Signal publishes both the client apps <em>and</em> the server code on GitHub.
            Threema publishes the iOS / Android / desktop apps as open source, and the server code is
            available for review by special arrangement. Both have been externally audited. Both are
            dramatically more transparent than WhatsApp or XChat.
          </p>

          <h3>User base: the practical axis</h3>
          <p>
            Signal has roughly 70 million monthly active users. Threema has roughly 1 million.
            Most of your contacts already have Signal installed, which is why it has been the default
            "no excuses encrypted messenger" recommendation since 2014. Threema wins on purity but
            loses on the network effect — it's harder to convince contacts to install a paid app.
          </p>

          <h3>Verdict</h3>
          <p>
            Choose Signal if you want the proven safe default: free, nonprofit, big user base, top-tier
            encryption, accept the phone-number requirement. Choose Threema if your privacy posture
            demands no identifiers from day one, you live in Europe, or you want a small commercial
            product over a donation-funded nonprofit.
          </p>
          <p>
            There is no wrong answer. Both will dramatically improve your privacy versus SMS, iMessage,
            or a server-encrypted messenger like Telegram's default chats. Pick the one whose trade-offs
            you can explain to yourself, and use it consistently.
          </p>
        </div>
      </div>
    </section>

    <!-- ============== FAQ ============== -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Common questions</h2>
        <div class="faq-list">
          <details>
            <summary>
              <h3 class="faq-q-title">Which is more secure, Signal or Threema?</h3>
            </summary>
            <div class="faq-body">
              Both run end-to-end encryption with public protocols and external audits. Neither has a known cryptographic advantage. Threema wins on identity (no phone number) and storage jurisdiction (Switzerland). Signal wins on user base and ecosystem. For most users they're equally secure; the choice is about your threat model.
            </div>
          </details>
          <details>
            <summary>
              <h3 class="faq-q-title">Is Threema worth paying for if Signal is free?</h3>
            </summary>
            <div class="faq-body">
              If you value anonymity from day one, no phone number, and a Swiss-hosted app, yes — Threema is one of the few messengers in production that gives you all three. If you're fine giving a phone number and using a US-hosted service, Signal is fine and saves you $4.
            </div>
          </details>
          <details>
            <summary>
              <h3 class="faq-q-title">Why do people use Threema instead of WhatsApp?</h3>
            </summary>
            <div class="faq-body">
              Because Threema's identity model (random ID) and Swiss jurisdiction sit further from the Big Tech data-grab model. WhatsApp is convenient but routes metadata through Meta; Threema routes nothing through any third party.
            </div>
          </details>
          <details>
            <summary>
              <h3 class="faq-q-title">Can I use Signal and Threema together?</h3>
            </summary>
            <div class="faq-body">
              Yes — many privacy-conscious users install both. Use Signal for everyday encrypted chat with people who already have it; use Threema for the stricter use cases (sensitive conversations, EU-based) where you want full anonymity.
            </div>
          </details>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  /* ===== Hero ===== */
  .compare-hero {
    text-align: center;
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(ellipse at top, rgba(29, 155, 240, 0.05), transparent 60%),
      var(--bg-primary);
  }

  .breadcrumb {
    font-size: 0.8125rem;
    margin-bottom: 2.5rem;
  }

  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .crumb-sep { margin: 0 0.5rem; }

  .compare-hero h1 {
    max-width: 820px;
    margin: 0 auto 1.25rem;
  }

  .compare-hero .lead {
    font-size: 1.0625rem;
    max-width: 680px;
    margin: 0 auto;
  }

  /* ===== Hero VS layout ===== */
  .hero-vs {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }

  .vs-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
  }

  .vs-monogram {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 800;
    color: white;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 8px 24px rgba(0, 0, 0, 0.3);
    letter-spacing: -0.04em;
  }

  .vs-name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .vs-score {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-light);
  }

  .vs-score .score-out {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .vs-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0 0.5rem;
  }

  .vs-divider span {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  /* ===== Comparison table ===== */
  .section-title {
    text-align: center;
    margin-bottom: 2rem;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .table-wrap {
    max-width: 880px;
    margin: 0 auto;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-card);
  }

  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    min-width: 600px;
  }

  .cmp-table th,
  .cmp-table td {
    padding: 0.875rem 1.125rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .cmp-table thead th {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.02);
  }

  .cmp-table tbody td {
    color: var(--text-secondary);
  }

  .cmp-table tbody tr:last-child td { border-bottom: none; }
  .cmp-table tbody tr:hover { background: rgba(255, 255, 255, 0.015); }

  .cmp-label {
    font-weight: 600;
    color: var(--text-primary);
    min-width: 180px;
  }

  .col-a { color: var(--text-primary); }
  .col-b { color: var(--text-primary); }

  .col-win {
    background: rgba(29, 155, 240, 0.06);
    font-weight: 600;
  }

  .winner-mark {
    color: var(--accent-light);
    margin-right: 0.375rem;
    font-size: 1rem;
  }

  .cmp-note {
    font-size: 0.8125rem;
    text-align: center;
    max-width: 600px;
    margin: 1rem auto 0;
    line-height: 1.65;
  }

  /* ===== Pick cards ===== */
  .pick-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 920px;
    margin: 0 auto;
  }

  .pick-card {
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-card);
    transition: border-color 0.3s, transform 0.3s var(--ease-smooth);
  }

  .pick-card:hover { transform: translateY(-2px); }

  .pick-card header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .pick-monogram {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: white;
    font-size: 0.9375rem;
  }

  .pick-card h3 { font-size: 1.125rem; margin: 0; }

  .pick-card ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .pick-card ul li {
    padding-left: 1.5rem;
    position: relative;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pick-card ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.625rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-light);
    opacity: 0.7;
  }

  .pick-cta {
    color: var(--accent-light);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }

  .pick-cta:hover { border-color: var(--accent-light); }

  .pick-a {
    border-color: rgba(37, 146, 233, 0.3);
    background:
      radial-gradient(ellipse at top, rgba(37, 146, 233, 0.06), transparent 70%),
      var(--bg-card);
  }

  .pick-b {
    border-color: rgba(35, 39, 42, 0.3);
    background:
      radial-gradient(ellipse at top, rgba(255, 255, 255, 0.04), transparent 70%),
      var(--bg-card);
  }

  /* ===== Long-form prose (reuses styles from review) ===== */
  .prose {
    max-width: 720px;
    margin: 0 auto;
    color: var(--text-secondary);
  }

  .prose h2 {
    color: var(--text-primary);
    font-size: 1.625rem;
    margin: 2.5rem 0 1.25rem;
  }

  .prose h3 {
    color: var(--text-primary);
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }

  .prose p {
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .prose strong { color: var(--text-primary); font-weight: 600; }
  .prose em { font-style: italic; color: var(--text-primary); }
  .prose a { color: var(--accent-light); text-decoration: none; border-bottom: 1px dotted rgba(77, 181, 245, 0.4); }
  .prose a:hover { border-bottom-color: var(--accent-light); }

  .faq-list {
    max-width: 720px;
    margin: 0 auto;
  }

  /* ===== Responsive ===== */
  @media (max-width: 720px) {
    .pick-grid { grid-template-columns: 1fr; }
    .hero-vs { gap: 0.75rem; }
    .vs-monogram { width: 56px; height: 56px; font-size: 1.25rem; }
    .compare-hero { padding-top: 3.5rem; }
  }
</style>
