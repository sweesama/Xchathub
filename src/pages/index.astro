---
/**
 * index.astro — 首页
 *
 * 首屏是 XChat 群组 + 使用指南（搜索点击主要落在 /groups）。
 * 加密通信评测和对比留在页面后半，入口还在，不再当首页标题。
 */
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/AppIcon.astro';
import {
  XCHAT_ANDROID_STATUS,
  XCHAT_LAUNCH_DISPLAY,
  XCHAT_STANDALONE_APP_REMOVED_ON,
} from '../data/xchat';
import {
  getAppsRanked,
  formatPrice,
  formatEncryption,
} from '../data/messagingApps';
import { GROUP_CATEGORY_META } from '../data/groupCategoryMeta';
import { DIRECTORY_LAST_UPDATED, SORTED_GROUP_DIRECTORY } from '../data/groups';

const listedGroupCount = SORTED_GROUP_DIRECTORY.length;
const categoryCount = GROUP_CATEGORY_META.length;

const buildDate = new Date();
const buildDateDisplay = buildDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const currentYear = 2026;

const ranked = getAppsRanked();
const topFive = ranked.slice(0, 5);

/* FAQ — 改写为新垂类 */
const faqs = [
  {
    question: 'Where can I find XChat groups?',
    answer:
      'XChat has no built-in group search. The <a href="/groups">XChat groups directory</a> lists public invite links after a manual check. New listings say “Source checked”, not “Verified”. There is a <a href="/zh/xchat-groups">Chinese guide</a>, a <a href="/es/grupos-xchat">Spanish page</a>, and a <a href="/pt/grupos-xchat">Brazilian Portuguese page for grupos xchat</a>.',
  },
  {
    question: 'How do I join an XChat group?',
    answer:
      'Open a link that starts with https://x.com/i/chat/group_join/ in the XChat app, then tap Request to Join and wait for an admin. The <a href="/how-to-join-xchat-group">join guide</a> covers iOS, Android, and the web client, plus what to do if a request stays pending.',
  },
  {
    question: 'What is the safest encrypted messaging app?',
    answer:
      'In 2026, <strong>Signal</strong> and <strong>Threema</strong> are widely considered the safest options. Signal is a free nonprofit with the peer-reviewed Signal Protocol and minimal metadata collection. Threema is a paid Swiss app with no phone number required. Both are open-source and externally audited. See our <a href="/best-encrypted-messaging-apps">full ranking</a> for the top 10.',
  },
  {
    question: 'Are all encrypted messengers really private?',
    answer:
      '<strong>No.</strong> Apps like Telegram, Facebook Messenger, and Discord use server-side encryption but only optional or partial end-to-end encryption. With default settings, your messages sit on their servers readable to the operator. Truly private messengers — Signal, Threema, Wire, Session, SimpleX, Briar, Element, WhatsApp, and XChat — run E2EE by default.',
  },
  {
    question: 'What about XChat?',
    answer:
      `XChat is encrypted chat from X Corp, launched on <strong>${XCHAT_LAUNCH_DISPLAY}</strong>. The separate store apps were removed around <strong>${XCHAT_STANDALONE_APP_REMOVED_ON}</strong>. Chat now lives inside the X app and at chat.x.com. It runs end-to-end encryption by default with no phone number required, but the protocol is proprietary and not yet independently audited. See our full <a href="/reviews/xchat/">XChat review</a> for the trade-offs.`,
  },
  {
    question: 'Which messenger does not require a phone number?',
    answer:
      '<strong>Threema</strong>, <strong>Session</strong>, and <strong>SimpleX</strong> do not require a phone number or email — you generate a random ID at signup. XChat uses your X account handle instead. All other mainstream encrypted messengers (Signal, WhatsApp, Telegram, Wire, Element, Briar) require some form of identifier at signup.',
  },
  {
    question: 'Is open source necessary for an encrypted messenger?',
    answer:
      'It is <strong>strongly preferred but not strictly required</strong>. Open-source code lets independent security researchers verify that the cryptography actually works as advertised. Closed-source apps like WhatsApp and XChat rely on claims rather than audits. The most trusted messengers in 2026 — Signal, Threema, Wire, Session, Element — are all open source.',
  },
  {
    question: 'Will the NSA / my government be able to read my messages?',
    answer:
      'In properly end-to-end encrypted apps, your messages cannot be read by any third party — including the operator, governments, or hackers with access to the servers. What is <em>not</em> encrypted is <strong>metadata</strong> (who is messaging whom, when, how often) which can be subpoenaed. Apps like Signal (sealed-sender), Threema (Swiss jurisdiction), and SimpleX (no IDs at all) minimize metadata as well.',
  },
  {
    question: 'Is it safe to use Telegram, WhatsApp, and iMessage?',
    answer:
      '<strong>Telegram\'s default chats are NOT end-to-end encrypted</strong> — only "Secret Chats" are. <strong>WhatsApp IS end-to-end encrypted by default</strong>, using the Signal Protocol, but routes metadata to Meta. <strong>iMessage IS encrypted between Apple devices</strong> but Apple still has access to backup keys unless you turn on Advanced Data Protection. All three can be safer than SMS, but none is as secure as Signal or Threema.',
  },
  {
    question: 'What is the best encrypted messaging app for my situation?',
    answer:
      'Read our <a href="/best-encrypted-messaging-apps">full ranking</a> for an overview, or jump to the specific review that matches your needs: <a href="/reviews/signal">Signal review</a> (overall gold standard), <a href="/reviews/threema">Threema review</a> (no phone number), <strong>Wire</strong> review (teams), <strong>Session</strong> review (anonymity), <strong>Briar</strong> review (internet-restricted regions).',
  },
];

/* JSON-LD */
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer.replace(/<[^>]*>/g, ''),
        },
      })),
    },
    {
      '@type': 'ItemList',
      name: `Best Encrypted Messaging Apps in ${currentYear}`,
      description: `Independent ranking of encrypted messaging apps as of ${buildDateDisplay} ${currentYear}.`,
      itemListElement: ranked.slice(0, 10).map((app, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: app.name,
        description: app.tagline,
        url: `https://xchat.directory/reviews/${app.slug}/`,
      })),
    },
  ],
};
---

<Layout
  title="XChat Groups & Guides — Public Links and How to Join"
  description="Find public XChat group links and the guides for joining, creating, and using group chat safely. Encrypted messenger comparisons are further down the page."
  jsonLd={pageJsonLd}
  canonicalPath="/"
  ogImage="/og-groups.png"
  ogImageAlt="XChat groups and guides — public invite links and how to join"
  breadcrumbs={[{ name: 'Home', url: 'https://xchat.directory/' }]}
>
  <!-- ========================= HERO ========================= -->
  <section class="hero section" id="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-container">
      <div class="status-bar">
        <span class="badge badge-live">
          <span class="pulse-dot pulse-dot-live"></span>
          Inside the X app
        </span>
        <span class="badge badge-pending">
          <span class="pulse-dot pulse-dot-pending"></span>
          Launched {XCHAT_LAUNCH_DISPLAY}
        </span>
      </div>

      <h1 class="hero-title">
        <span class="text-gradient">XChat Groups &amp; Guides</span>
      </h1>
      <p class="hero-subtitle text-secondary prose-body">
        XChat has no built-in group search. Browse public groups we have checked by hand,
        then use the guides to join, create a link, or stay safer in group chat.
        Encrypted messenger comparisons are <a href="#encryption">further down this page</a>.
      </p>

      <div class="cta-buttons hero-cta">
        <a href="/groups" class="btn btn-primary btn-lg">
          Browse XChat Groups →
        </a>
        <a href="/how-to-join-xchat-group" class="btn btn-secondary btn-lg">
          How to Join a Group
        </a>
      </div>

      <div class="stats-row">
        <div class="stat-item">
          <span class="stat-number">{listedGroupCount}</span>
          <span class="stat-label text-muted">Groups listed</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">{categoryCount}</span>
          <span class="stat-label text-muted">Categories</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">{DIRECTORY_LAST_UPDATED.slice(0, 7)}</span>
          <span class="stat-label text-muted">Last updated {DIRECTORY_LAST_UPDATED}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= GUIDES ========================= -->
  <section class="section" id="guides">
    <div class="container">
      <div class="section-header">
        <h2>Groups, then the guides</h2>
        <p class="text-secondary">Start with the directory. The short guides cover joining, creating a link, and what to watch for in a group chat. <a href="/zh/xchat-groups" hreflang="zh-CN" lang="zh-CN">中文指南</a> covers the same questions in Chinese, <a href="/es/grupos-xchat" hreflang="es" lang="es">grupos de XChat</a> does the same in Spanish, and <a href="/pt/grupos-xchat" hreflang="pt-BR" lang="pt-BR">grupos xchat</a> does it in Brazilian Portuguese.</p>
      </div>
      <div class="compare-grid">
        <a href="/groups" class="compare-card compare-card-xchat">
          <div class="compare-vs">Directory</div>
          <h3>Public XChat groups</h3>
          <p class="text-secondary">{listedGroupCount} groups listed, each with the date the invite was last checked.</p>
          <span class="card-arrow">→</span>
        </a>
        <a href="/how-to-join-xchat-group" class="compare-card">
          <div class="compare-vs">Guide</div>
          <h3>How to join a group</h3>
          <p class="text-secondary">Open an invite on iOS, Android, or chat.x.com, then request to join.</p>
          <span class="card-arrow">→</span>
        </a>
        <a href="/how-to-create-group-link" class="compare-card">
          <div class="compare-vs">Guide</div>
          <h3>Create a group link</h3>
          <p class="text-secondary">Turn on a public invite and share a link that starts with x.com/i/chat/group_join/.</p>
          <span class="card-arrow">→</span>
        </a>
        <a href="/xchat-group-chat-safety" class="compare-card">
          <div class="compare-vs">Guide</div>
          <h3>Group chat safety</h3>
          <p class="text-secondary">What a real XChat invite looks like, and which links to leave alone.</p>
          <span class="card-arrow">→</span>
        </a>
        <a href="/what-is-xchat" class="compare-card">
          <div class="compare-vs">Guide</div>
          <h3>What is XChat?</h3>
          <p class="text-secondary">Platforms, encryption, group limits, and how it differs from X Communities.</p>
          <span class="card-arrow">→</span>
        </a>
        <a href="/zh/xchat-groups" class="compare-card" hreflang="zh-CN" lang="zh-CN">
          <div class="compare-vs">中文</div>
          <h3>XChat 群组指南</h3>
          <p class="text-secondary">去哪找群、怎么加入、怎么建群，用中文写的同一套说明。</p>
          <span class="card-arrow">→</span>
        </a>
        <a href="/es/grupos-xchat" class="compare-card" hreflang="es" lang="es">
          <div class="compare-vs">Español</div>
          <h3>Grupos de XChat</h3>
          <p class="text-secondary">Dónde están los grupos XChat ya comprobados, en español.</p>
          <span class="card-arrow">→</span>
        </a>
        <a href="/pt/grupos-xchat" class="compare-card" hreflang="pt-BR" lang="pt-BR">
          <div class="compare-vs">Português</div>
          <h3>Grupos XChat</h3>
          <p class="text-secondary">Grupos xchat com links públicos, em português do Brasil.</p>
          <span class="card-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================= ENCRYPTION COMPARISONS ========================= -->
  <section class="section" id="encryption">
    <div class="container">
      <div class="section-header">
        <h2>Encrypted messenger comparisons</h2>
        <p class="text-secondary">If you are choosing an app, not looking for an XChat group, the ranking below is independent and unsponsored. <a href="/best-encrypted-messaging-apps">See all {ranked.length} ranked →</a></p>
      </div>

      <div class="top-list">
        {topFive.map((app, i) => (
          <a href={`/reviews/${app.slug}/`} class="top-row">
            <span class="top-num">{i + 1}</span>
            <AppIcon app={app} class="top-monogram" />
            <div class="top-meta">
              <h3>{app.name}</h3>
              <p class="text-secondary">{app.tagline}</p>
              <div class="top-mini">
                <span>{formatPrice(app)}</span>
                <span class="dot">·</span>
                <span>{formatEncryption(app)}</span>
                <span class="dot">·</span>
                <span>{app.openSource ? 'Open source' : 'Closed source'}</span>
              </div>
            </div>
            <div class="top-score">
              <span class="score-num">{app.editorScore.toFixed(1)}</span>
              <span class="score-out">/ 10</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= POPULAR COMPARISONS ========================= -->
  <section class="section" id="comparisons">
    <div class="container">
      <div class="section-header">
        <h2>Popular side-by-side comparisons</h2>
        <p class="text-secondary">
          Highest-traffic decision pages — for users who already know which two apps they're comparing.
        </p>
      </div>

      <div class="compare-grid">
        <a href="/compare/signal-vs-threema/" class="compare-card">
          <div class="compare-vs">
            <AppIcon app={ranked.find((a) => a.slug === 'signal')!} class="vs-monogram" />
            <span class="vs-text">vs</span>
            <AppIcon app={ranked.find((a) => a.slug === 'threema')!} class="vs-monogram" />
          </div>
          <h3>Signal vs Threema</h3>
          <p class="text-secondary">Free nonprofit vs paid Swiss app — which has stronger privacy?</p>
          <span class="card-arrow">→</span>
        </a>

        <a href="/reviews/signal/" class="compare-card">
          <div class="compare-vs">
            <AppIcon app={ranked.find((a) => a.slug === 'signal')!} class="vs-monogram" />
            <span class="vs-text">Review</span>
          </div>
          <h3>Signal Review (2026)</h3>
          <p class="text-secondary">The full audit, pros, cons, and verdict for the gold standard.</p>
          <span class="card-arrow">→</span>
        </a>

        <a href="/reviews/xchat/" class="compare-card compare-card-xchat">
          <div class="compare-vs">
            <AppIcon app={ranked.find((a) => a.slug === 'xchat')!} class="vs-monogram" />
            <span class="vs-text">Review</span>
          </div>
          <h3>XChat Review (2026)</h3>
          <p class="text-secondary">The new kid from X Corp — proprietary E2EE, no phone, social-graph native.</p>
          <span class="card-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================= XCHAT SECTION (BRAND PRESERVATION) ========================= -->
  <section class="section xchat-section" id="xchat">
    <div class="container">
      <div class="xchat-card card">
        <div class="xchat-pitch">
          <AppIcon app={ranked.find((a) => a.slug === 'xchat')!} class="xchat-monogram trio-monogram" />
          <div class="xchat-content">
            <span class="badge badge-live">
              <span class="pulse-dot pulse-dot-live"></span>
              Inside the X app
            </span>
            <h2>XChat group chat lives in the X app</h2>
            <p class="text-secondary">
              The product launched {XCHAT_LAUNCH_DISPLAY}. The separate store apps were removed around {XCHAT_STANDALONE_APP_REMOVED_ON}.
              Use the directory for public invites, the Android page for what to do instead of a dead Play listing, and the web guide for chat.x.com.
            </p>
            <div class="cta-buttons">
              <a href="/groups" class="btn btn-primary btn-sm">
                Public Groups →
              </a>
              <a href="/android" class="btn btn-secondary btn-sm">
                Android
              </a>
              <a href="/web" class="btn btn-secondary btn-sm">
                Web
              </a>
            </div>
          </div>
        </div>
        <div class="xchat-quickfacts">
          <div class="fact">
            <span class="fact-label">Launched</span>
            <span class="fact-val">{XCHAT_LAUNCH_DISPLAY}</span>
          </div>
          <div class="fact">
            <span class="fact-label">Where</span>
            <span class="fact-val">X app or chat.x.com</span>
          </div>
          <div class="fact">
            <span class="fact-label">Android</span>
            <span class="fact-val">{XCHAT_ANDROID_STATUS}</span>
          </div>
          <div class="fact">
            <span class="fact-label">Group Size</span>
            <span class="fact-val">Up to 1,000</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= HOW WE RATE ========================= -->
  <section class="section how-section" id="how">
    <div class="container">
      <div class="section-header">
        <h2>How we test and rate</h2>
        <p class="text-secondary">No paid placements, no sponsored rankings.</p>
      </div>
      <div class="how-grid">
        <div class="how-card">
          <h3>🔐 Encryption</h3>
          <p class="text-secondary">E2EE on every chat, group, and call — by default, not as an opt-in toggle users forget about.</p>
        </div>
        <div class="how-card">
          <h3>📖 Open Source</h3>
          <p class="text-secondary">Both client and server code publicly auditable, with documented third-party security reviews.</p>
        </div>
        <div class="how-card">
          <h3>🏛️ Ownership</h3>
          <p class="text-secondary">Nonprofit, donation-funded, one-time paid, or commercial-ad-supported? We score how much pressure there is to monetize you.</p>
        </div>
        <div class="how-card">
          <h3>🕶️ Identity</h3>
          <p class="text-secondary">Phone number, email, or random ID? Where is the data hosted? How much metadata leaks?</p>
        </div>
        <div class="how-card">
          <h3>🛠️ Practical UX</h3>
          <p class="text-secondary">Cross-platform support, polish, feature gap, group limits, and whether your contacts can install it.</p>
        </div>
        <div class="how-card">
          <h3>📅 Freshness</h3>
          <p class="text-secondary">Reviewed at least twice a year — every score has a "last reviewed" date so you know if the verdict is current.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= FAQ ========================= -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-header">
        <h2>Frequently asked questions</h2>
        <p class="text-secondary">Plain answers to the questions people actually search for.</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details open={i === 0}>
            <summary>
              <h3 class="faq-q-title">{faq.question}</h3>
            </summary>
            <div class="faq-body" set:html={faq.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= FINAL CTA ========================= -->
  <section class="section final-cta-section">
    <div class="container">
      <div class="final-cta-card">
        <h2 class="final-cta-title">List a group, or compare apps</h2>
        <p class="text-secondary final-cta-desc">
          Group listings are free and reviewed by hand. The encryption rankings stay on this site if you are still choosing a messenger.
        </p>
        <div class="cta-buttons" style="justify-content: center; margin-top: 1.5rem;">
          <a href="/list-your-group" class="btn btn-primary btn-lg">
            List your group
          </a>
          <a href="/best-encrypted-messaging-apps" class="btn btn-secondary btn-lg">
            Messenger ranking →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>


<style>
  /* ===== Hero ===== */
  .hero {
    text-align: center;
    padding-top: 7rem;
    padding-bottom: 5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse, rgba(29, 155, 240, 0.08) 0%, rgba(29, 155, 240, 0.02) 40%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .status-bar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-title {
    margin-bottom: 1.25rem;
    max-width: 820px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: 1.0625rem;
    max-width: 640px;
    margin-bottom: 2.5rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-subtitle strong { color: var(--text-primary); font-weight: 600; }

  .hero-cta { margin-bottom: 3.5rem; }

  /* ===== Stats ===== */
  .stats-row {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 2rem;
    background: var(--border);
  }

  /* ===== Section header shared ===== */
  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .section-header h2 { margin-bottom: 0.625rem; }
  .section-header p {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-header a { color: var(--accent-light); text-decoration: none; border-bottom: 1px dotted rgba(77, 181, 245, 0.4); }
  .section-header a:hover { border-color: var(--accent-light); }

  /* ===== Top picks list ===== */
  .top-list {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .top-row {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s, transform 0.3s var(--ease-smooth);
  }

  .top-row:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .top-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-muted);
    width: 32px;
    text-align: center;
  }

  .top-row:first-child .top-num { color: var(--accent-light); }

  .top-monogram {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: white;
    font-size: 1.0625rem;
  }

  .top-meta { min-width: 0; }
  .top-meta h3 { font-size: 1.0625rem; margin: 0 0 0.125rem; }
