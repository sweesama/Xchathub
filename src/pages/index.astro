---
/**
 * index.astro — 首页
 *
 * 2026 重新定位：从 "XChat only" 目录站升级为 "加密通信垂类 + XChat hub" 站点
 *
 * 三大模块（新定位）：
 *   1. Hero — 加密通信垂类 + XChat 自家位置
 *   2. Top ranked apps 卡片（前 5 名）
 *   3. XChat 保留位（自家品牌）
 *   4. How we rate（信誉信号）
 *   5. FAQ
 */
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/AppIcon.astro';
import {
  XCHAT_ANDROID_STATUS,
  XCHAT_IOS_REQUIREMENT,
  XCHAT_LAUNCH_DISPLAY,
  XCHAT_TELEGRAM_CHANNEL_URL,
} from '../data/xchat';
import {
  getAppsRanked,
  formatPrice,
  formatEncryption,
} from '../data/messagingApps';

const buildDate = new Date();
const buildDateISO = buildDate.toISOString().split('T')[0];
const buildDateDisplay = buildDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const currentYear = 2026;

const ranked = getAppsRanked();
const topFive = ranked.slice(0, 5);

/* FAQ — 改写为新垂类 */
const faqs = [
  {
    question: 'What is the safest encrypted messaging app?',
    answer:
      'In 2026, <strong>Signal</strong> and <strong>Threema</strong> are widely considered the safest options. Signal is a free nonprofit with the peer-reviewed Signal Protocol and minimal metadata collection. Threema is a paid Swiss app with no phone number required. Both are open-source and externally audited. See our <a href="/best-encrypted-messaging-apps">full ranking</a> for the top 10.',
  },
  {
    question: 'Are all encrypted messengers really private?',
    answer:
      '<strong>No.</strong> Apps like Telegram, Facebook Messenger, and Discord use server-side encryption but only optional or partial end-to-end encryption. With default settings, your messages sit on their servers readable to the operator. Truly private messengers — Signal, Threema, Wire, Session, SimpleX, Briar, Element, WhatsApp, and XChat — run E2EE by default.',
  },
  {
    question: 'What about XChat?',
    answer:
      `XChat is the newest encrypted messenger from X Corp, launched on <strong>${XCHAT_LAUNCH_DISPLAY}</strong> on iOS. By July 2026 it had also shipped an Android client (com.x.chat on the Play Store). It runs end-to-end encryption by default with no phone number required, but the protocol is proprietary and not yet independently audited. See our full <a href="/reviews/xchat/">XChat review</a> for the trade-offs.`,
  },
  {
    question: 'Which messenger does not require a phone number?',
    answer:
      '<strong>Threema</strong>, <strong>Session</strong>, and <strong>SimpleX</strong> do not require a phone number or email — you generate a random ID at signup. XChat uses your X account handle instead. All other mainstream encrypted messengers (Signal, WhatsApp, Telegram, Wire, Element, Briar) require some form of identifier at signup.',
  },
  {
    question: 'Is open source necessary for an encrypted messenger?',
    answer:
      'It is <strong>strongly preferred but not strictly required</strong>. Open-source code lets independent security researchers verify that the cryptography actually works as advertised. Closed-source apps like WhatsApp and XChat rely on claims rather than audits. The most trusted messengers in 2026 — Signal, Threema, Wire, Session, Element — are all open source.',
  },
  {
    question: 'Will the NSA / my government be able to read my messages?',
    answer:
      'In properly end-to-end encrypted apps, your messages cannot be read by any third party — including the operator, governments, or hackers with access to the servers. What is <em>not</em> encrypted is <strong>metadata</strong> (who is messaging whom, when, how often) which can be subpoenaed. Apps like Signal (sealed-sender), Threema (Swiss jurisdiction), and SimpleX (no IDs at all) minimize metadata as well.',
  },
  {
    question: 'Is it safe to use Telegram, WhatsApp, and iMessage?',
    answer:
      '<strong>Telegram\'s default chats are NOT end-to-end encrypted</strong> — only "Secret Chats" are. <strong>WhatsApp IS end-to-end encrypted by default</strong>, using the Signal Protocol, but routes metadata to Meta. <strong>iMessage IS encrypted between Apple devices</strong> but Apple still has access to backup keys unless you turn on Advanced Data Protection. All three can be safer than SMS, but none is as secure as Signal or Threema.',
  },
  {
    question: 'What is the best encrypted messaging app for my situation?',
    answer:
      'Read our <a href="/best-encrypted-messaging-apps">full ranking</a> for an overview, or jump to the specific review that matches your needs: <a href="/reviews/signal">Signal review</a> (overall gold standard), <a href="/reviews/threema">Threema review</a> (no phone number), <strong>Wire</strong> review (teams), <strong>Session</strong> review (anonymity), <strong>Briar</strong> review (internet-restricted regions).',
  },
];

/* JSON-LD */
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer.replace(/<[^>]*>/g, ''),
        },
      })),
    },
    {
      '@type': 'ItemList',
      name: `Best Encrypted Messaging Apps in ${currentYear}`,
      description: `Independent ranking of encrypted messaging apps as of ${buildDateDisplay} ${currentYear}.`,
      itemListElement: ranked.slice(0, 10).map((app, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: app.name,
        description: app.tagline,
        url: `https://xchat.directory/reviews/${app.slug}/`,
      })),
    },
  ],
};
---

<Layout
  title="xchat.directory — Encrypted Messenger Directory"
  description="The honest directory for encrypted messaging. Compare Signal, Threema, Wire, Session, WhatsApp, XChat and more. Long-form reviews and the 2026 ranked list."
  jsonLd={pageJsonLd}
  canonicalPath=""
  breadcrumbs={[{ name: 'Home', url: 'https://xchat.directory/' }]}
>
  <!-- ========================= HERO ========================= -->
  <section class="hero section" id="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-container">
      <div class="status-bar">
        <span class="badge badge-live">
          <span class="pulse-dot pulse-dot-live"></span>
          {ranked.length} apps reviewed
        </span>
        <span class="badge badge-pending">
          <span class="pulse-dot pulse-dot-pending"></span>
          Updated monthly
        </span>
      </div>

      <h1 class="hero-title">
        Find the <span class="text-gradient">encrypted messenger</span><br />
        that actually protects you.
      </h1>
      <p class="hero-subtitle text-secondary prose-body">
        An independent, ad-free directory of encrypted messaging apps.
        Side-by-side comparisons, in-depth reviews, and a transparent ranking —
        covering Signal, Threema, Wire, XChat, and a dozen others.
        Updated <time datetime={buildDateISO}>{buildDateDisplay} {currentYear}</time>.
      </p>

      <div class="cta-buttons hero-cta">
        <a href="/best-encrypted-messaging-apps" class="btn btn-primary btn-lg">
          See the 2026 Ranking →
        </a>
        <a href="/reviews/signal/" class="btn btn-secondary btn-lg">
          Read Signal Review
        </a>
      </div>

      <div class="stats-row">
        <div class="stat-item">
          <span class="stat-number">{ranked.length}</span>
          <span class="stat-label text-muted">Apps Reviewed</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">100%</span>
          <span class="stat-label text-muted">Independent</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">0</span>
          <span class="stat-label text-muted">Sponsored Picks</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= TOP 5 RANKED ========================= -->
  <section class="section" id="top-picks">
    <div class="container">
      <div class="section-header">
        <h2>The 2026 Top 5</h2>
        <p class="text-secondary">Our editorial ranking based on encryption, audits, ownership, and real-world use. <a href="/best-encrypted-messaging-apps">See all 10 ranked →</a></p>
      </div>

      <div class="top-list">
        {topFive.map((app, i) => (
          <a href={`/reviews/${app.slug}/`} class="top-row">
            <span class="top-num">{i + 1}</span>
            <AppIcon app={app} class="top-monogram" />
            <div class="top-meta">
              <h3>{app.name}</h3>
              <p class="text-secondary">{app.tagline}</p>
              <div class="top-mini">
                <span>{formatPrice(app)}</span>
                <span class="dot">·</span>
                <span>{formatEncryption(app)}</span>
                <span class="dot">·</span>
                <span>{app.openSource ? 'Open source' : 'Closed source'}</span>
              </div>
            </div>
            <div class="top-score">
              <span class="score-num">{app.editorScore.toFixed(1)}</span>
              <span class="score-out">/ 10</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= POPULAR COMPARISONS ========================= -->
  <section class="section" id="comparisons">
    <div class="container">
      <div class="section-header">
        <h2>Popular side-by-side comparisons</h2>
        <p class="text-secondary">
          Highest-traffic decision pages — for users who already know which two apps they're comparing.
        </p>
      </div>

      <div class="compare-grid">
        <a href="/compare/signal-vs-threema/" class="compare-card">
          <div class="compare-vs">
            <span class="vs-monogram" style="background:#2592e9">S</span>
            <span class="vs-text">vs</span>
            <span class="vs-monogram" style="background:#23272a">T</span>
          </div>
          <h3>Signal vs Threema</h3>
          <p class="text-secondary">Free nonprofit vs paid Swiss app — which has stronger privacy?</p>
          <span class="card-arrow">→</span>
        </a>

        <a href="/reviews/signal/" class="compare-card">
          <div class="compare-vs">
            <span class="vs-monogram" style="background:#2592e9">S</span>
            <span class="vs-text">Review</span>
          </div>
          <h3>Signal Review (2026)</h3>
          <p class="text-secondary">The full audit, pros, cons, and verdict for the gold standard.</p>
          <span class="card-arrow">→</span>
        </a>

        <a href="/reviews/xchat/" class="compare-card compare-card-xchat">
          <div class="compare-vs">
            <span class="vs-monogram" style="background:#1d9bf0">X</span>
            <span class="vs-text">Review</span>
          </div>
          <h3>XChat Review (2026)</h3>
          <p class="text-secondary">The new kid from X Corp — proprietary E2EE, no phone, social-graph native.</p>
          <span class="card-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================= XCHAT SECTION (BRAND PRESERVATION) ========================= -->
  <section class="section xchat-section" id="xchat">
    <div class="container">
      <div class="xchat-card card">
        <div class="xchat-pitch">
          <span class="xchat-monogram">X</span>
          <div class="xchat-content">
            <span class="badge badge-live">
              <span class="pulse-dot pulse-dot-live"></span>
              Live on iOS & Android
            </span>
            <h2>Still tracking XChat? We've got you.</h2>
            <p class="text-secondary">
              XChat is one of the apps we track closely. Get the Android status, group directory,
              web access guide, and side-by-side comparisons — everything an XChat user needs.
            </p>
            <div class="cta-buttons">
              <a href="/what-is-xchat" class="btn btn-primary btn-sm">
                XChat Overview →
              </a>
              <a href="/android" class="btn btn-secondary btn-sm">
                Android Status
              </a>
              <a href="/groups" class="btn btn-secondary btn-sm">
                Public Groups
              </a>
            </div>
          </div>
        </div>
        <div class="xchat-quickfacts">
          <div class="fact">
            <span class="fact-label">Launched</span>
            <span class="fact-val">{XCHAT_LAUNCH_DISPLAY}</span>
          </div>
          <div class="fact">
            <span class="fact-label">iOS</span>
            <span class="fact-val">{XCHAT_IOS_REQUIREMENT}</span>
          </div>
          <div class="fact">
            <span class="fact-label">Android</span>
            <span class="fact-val">{XCHAT_ANDROID_STATUS.split(',')[0]}</span>
          </div>
          <div class="fact">
            <span class="fact-label">Group Size</span>
            <span class="fact-val">Up to 1,000</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= HOW WE RATE ========================= -->
  <section class="section how-section" id="how">
    <div class="container">
      <div class="section-header">
        <h2>How we test and rate</h2>
        <p class="text-secondary">No paid placements, no sponsored rankings.</p>
      </div>
      <div class="how-grid">
        <div class="how-card">
          <h3>🔐 Encryption</h3>
          <p class="text-secondary">E2EE on every chat, group, and call — by default, not as an opt-in toggle users forget about.</p>
        </div>
        <div class="how-card">
          <h3>📖 Open Source</h3>
          <p class="text-secondary">Both client and server code publicly auditable, with documented third-party security reviews.</p>
        </div>
        <div class="how-card">
          <h3>🏛️ Ownership</h3>
          <p class="text-secondary">Nonprofit, donation-funded, one-time paid, or commercial-ad-supported? We score how much pressure there is to monetize you.</p>
        </div>
        <div class="how-card">
          <h3>🕶️ Identity</h3>
          <p class="text-secondary">Phone number, email, or random ID? Where is the data hosted? How much metadata leaks?</p>
        </div>
        <div class="how-card">
          <h3>🛠️ Practical UX</h3>
          <p class="text-secondary">Cross-platform support, polish, feature gap, group limits, and whether your contacts can install it.</p>
        </div>
        <div class="how-card">
          <h3>📅 Freshness</h3>
          <p class="text-secondary">Reviewed at least twice a year — every score has a "last reviewed" date so you know if the verdict is current.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= FAQ ========================= -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-header">
        <h2>Frequently asked questions</h2>
        <p class="text-secondary">Plain answers to the questions people actually search for.</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details open={i === 0}>
            <summary>
              <h3 class="faq-q-title">{faq.question}</h3>
            </summary>
            <div class="faq-body" set:html={faq.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= FINAL CTA ========================= -->
  <section class="section final-cta-section">
    <div class="container">
      <div class="final-cta-card">
        <h2 class="final-cta-title">Stay in the loop</h2>
        <p class="text-secondary final-cta-desc">
          We re-rank the top 10 every quarter. Get notified when major changes hit — like a new audit, a protocol change, or a Messenger shutdown.
        </p>
        <div class="cta-buttons" style="justify-content: center; margin-top: 1.5rem;">
          <a href={XCHAT_TELEGRAM_CHANNEL_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            Subscribe on Telegram
          </a>
          <a href="/faq" class="btn btn-secondary btn-lg">
            See all FAQs →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>


<style>
  /* ===== Hero ===== */
  .hero {
    text-align: center;
    padding-top: 7rem;
    padding-bottom: 5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse, rgba(29, 155, 240, 0.08) 0%, rgba(29, 155, 240, 0.02) 40%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .status-bar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-title {
    margin-bottom: 1.25rem;
    max-width: 820px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: 1.0625rem;
    max-width: 640px;
    margin-bottom: 2.5rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-subtitle strong { color: var(--text-primary); font-weight: 600; }

  .hero-cta { margin-bottom: 3.5rem; }

  /* ===== Stats ===== */
  .stats-row {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 2rem;
    background: var(--border);
  }

  /* ===== Section header shared ===== */
  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .section-header h2 { margin-bottom: 0.625rem; }
  .section-header p {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-header a { color: var(--accent-light); text-decoration: none; border-bottom: 1px dotted rgba(77, 181, 245, 0.4); }
  .section-header a:hover { border-color: var(--accent-light); }

  /* ===== Top picks list ===== */
  .top-list {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .top-row {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s, transform 0.3s var(--ease-smooth);
  }

  .top-row:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .top-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-muted);
    width: 32px;
    text-align: center;
  }

  .top-row:first-child .top-num { color: var(--accent-light); }

  .top-monogram {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: white;
    font-size: 1.0625rem;
  }

  .top-meta { min-width: 0; }
  .top-meta h3 { font-size: 1.0625rem; margin: 0 0 0.125rem; }
  .top-meta p { margin: 0 0 0.375rem; font-size: 0.8125rem; line-height: 1.4; }

  .top-mini {
    display: flex;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    align-items: center;
    flex-wrap: wrap;
  }
  .top-mini .dot { opacity: 0.5; }

  .top-score {
    text-align: center;
  }
  .top-score .score-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-light);
    letter-spacing: -0.04em;
    display: block;
  }
  .top-score .score-out {
    font-size: 0.6875rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ===== Compare cards ===== */
  .compare-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .compare-card {
    position: relative;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s, transform 0.3s var(--ease-smooth);
  }

  .compare-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .compare-vs {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .vs-monogram {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: white;
    font-size: 0.9375rem;
  }

  .compare-card h3 { font-size: 1.125rem; margin: 0 0 0.5rem; }
  .compare-card p { font-size: 0.875rem; line-height: 1.5; margin: 0; }

  .card-arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: var(--text-muted);
    font-size: 1.125rem;
    transition: color 0.15s, transform 0.2s;
  }
  .compare-card:hover .card-arrow { color: var(--accent-light); transform: translateX(2px); }

  .compare-card-xchat {
    border-color: rgba(29, 155, 240, 0.3);
    background: linear-gradient(135deg, rgba(29, 155, 240, 0.06), var(--bg-card));
  }

  /* ===== XChat section ===== */
  .xchat-section { background: rgba(255, 255, 255, 0.02); }
  .xchat-card {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
    padding: 0;
    overflow: hidden;
    max-width: 1080px;
    margin: 0 auto;
  }

  .xchat-pitch {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 2rem;
  }

  .xchat-monogram {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(135deg, #1d9bf0, #4db5f5);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .xchat-content h2 { font-size: 1.5rem; margin: 0.5rem 0 0.5rem; }
  .xchat-content p { margin: 0 0 1rem; line-height: 1.55; }

  .xchat-quickfacts {
    background: rgba(255, 255, 255, 0.02);
    border-left: 1px solid var(--border);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .fact { display: flex; flex-direction: column; gap: 0.125rem; }

  .fact-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .fact-val {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
