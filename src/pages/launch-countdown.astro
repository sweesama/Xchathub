---
/**
 * launch-countdown.astro — XChat Launch Day Recap
 *
 * SEO 战略：
 * 原为倒计时页，现已转为"发布日回顾"。继续捕获"xchat launch date"、"when did xchat launch"等关键词，
 * 同时服务于已发布后的用户查询"xchat launched"、"xchat release recap"。
 * 
 * 技术：保留倒计时UI作为历史展示，但叙事改为回顾性质。
 */
import Layout from '../layouts/Layout.astro';
import {
  XCHAT_CHAT_URL,
  XCHAT_LAUNCH_DISPLAY,
  XCHAT_LAUNCH_ISO,
  XCHAT_STANDALONE_APP_REMOVED_ON,
} from '../data/xchat';

/** 发布目标时刻：2026-04-25 00:00:00 UTC（按当前 App Store 列表显示） */
const launchDate = new Date(XCHAT_LAUNCH_ISO);
const now = new Date();
const msLeft = launchDate.getTime() - now.getTime();
const isLaunched = msLeft <= 0;

/* 用于兜底渲染（JS 禁用时仍能看到大致天数） */
const daysLeft = Math.max(0, Math.ceil(msLeft / (1000 * 60 * 60 * 24)));

/* JSON-LD: Event schema — 告诉 Google 这是一个时间相关的事件页 */
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'XChat Public Launch',
  startDate: XCHAT_LAUNCH_ISO,
  eventStatus: 'https://schema.org/EventOccurred',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  location: {
    '@type': 'VirtualLocation',
    url: XCHAT_CHAT_URL,
  },
  description: `XChat, X Corp's end-to-end encrypted chat, launched on ${XCHAT_LAUNCH_DISPLAY}. The separate store apps were later removed. Chat now lives in the X app and at chat.x.com.`,
  organizer: {
    '@type': 'Organization',
    name: 'X Corp',
    url: 'https://x.com',
  },
  image: 'https://xchat.directory/og-image.png',
};
---

<Layout
  title="XChat Launch Recap — Released April 24, 2026 | XChat Hub"
  description="XChat launched April 24, 2026. The separate App Store and Google Play apps were removed around September 14, 2026. Use chat inside the X app or open chat.x.com."
  jsonLd={eventJsonLd}
  canonicalPath="/launch-countdown"
  breadcrumbs={[
    { name: 'Home', url: 'https://xchat.directory/' },
    { name: 'Launch Countdown', url: 'https://xchat.directory/launch-countdown/' },
  ]}
>
  <!-- ==================== HERO + COUNTDOWN ==================== -->
  <section class="section countdown-hero">
    <div class="container">
      <span class="eyebrow">
        <span class="live-dot" aria-hidden="true"></span>
        {isLaunched ? 'Live Now' : `${daysLeft} Day${daysLeft === 1 ? '' : 's'} Left`}
      </span>
      <h1>
        {isLaunched ? (
          <>XChat <span class="text-gradient">Is Live.</span></>
        ) : (
          <>XChat Launches<br /><span class="text-gradient">{XCHAT_LAUNCH_DISPLAY}.</span></>
        )}
      </h1>
      <p class="lead text-secondary prose-body">
        XChat launched on April 24, 2026 with E2EE messaging, group chats, and video calls. The separate store apps were removed around {XCHAT_STANDALONE_APP_REMOVED_ON}. Chat now lives in the X app and at chat.x.com.
      </p>

      <!-- 倒计时盘 -->
      <div class="countdown" id="countdown" data-target={XCHAT_LAUNCH_ISO}>
        <div class="count-unit">
          <span class="count-num" id="count-days">{String(daysLeft).padStart(2, '0')}</span>
          <span class="count-label">Days</span>
        </div>
        <div class="count-unit">
          <span class="count-num" id="count-hours">00</span>
          <span class="count-label">Hours</span>
        </div>
        <div class="count-unit">
          <span class="count-num" id="count-mins">00</span>
          <span class="count-label">Minutes</span>
        </div>
        <div class="count-unit">
          <span class="count-num" id="count-secs">00</span>
          <span class="count-label">Seconds</span>
        </div>
      </div>

      <!-- CTA 按钮 -->
      <div class="cta-buttons">
        <a href={XCHAT_CHAT_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
          Open chat.x.com
        </a>
        <a href="/groups" class="btn btn-secondary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Browse Groups
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== WHAT TO EXPECT ==================== -->
  <section class="section">
    <div class="container">
      <div class="expect-wrap">
        <h2>What Shipped on Launch Day</h2>
        <div class="expect-grid">
          <article class="expect-card">
            <div class="expect-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12" y2="18"/></svg>
            </div>
            <h3>iPhone, iPad &amp; Android</h3>
            <p class="text-secondary">Those separate store listings were removed around {XCHAT_STANDALONE_APP_REMOVED_ON}. Use the X app or chat.x.com.</p>
          </article>
          <article class="expect-card">
            <div class="expect-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h3>E2E Encrypted</h3>
            <p class="text-secondary">Messages encrypted locally. Keys stored on device only. PIN-protected history. Screenshot blocking included.</p>
          </article>
          <article class="expect-card">
            <div class="expect-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3>Groups up to 350</h3>
            <p class="text-secondary">Launch day capacity: 350 members per group. Growing toward 1,000. Join via invite links.</p>
          </article>
          <article class="expect-card">
            <div class="expect-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Video Calls &amp; Voice</h3>
            <p class="text-secondary">Encrypted video and voice calls included at launch. Plus voice notes and file sharing.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FINAL CTA ==================== -->
  <section class="section final-section">
    <div class="container">
      <div class="final-card">
        <h2>Get Started with XChat</h2>
        <p class="text-secondary prose-body">
          Open chat.x.com or the X app, then use the groups directory for public invites.
        </p>
        <div class="cta-buttons" style="justify-content: center; margin-top: 1.5rem;">
          <a href={XCHAT_CHAT_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            Open chat.x.com
          </a>
          <a href="/groups" class="btn btn-secondary btn-lg">
            Browse Groups
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .countdown-hero {
    text-align: center;
    padding-top: 5rem;
    padding-bottom: 2rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-light);
    margin-bottom: 1.25rem;
    padding: 0.3125rem 0.875rem;
    border: 1px solid rgba(29, 155, 240, 0.25);
    border-radius: var(--radius-full);
    background: rgba(29, 155, 240, 0.05);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(29, 155, 240, 0.6);
    animation: live-pulse 1.8s ease-out infinite;
  }

  @keyframes live-pulse {
    0% { box-shadow: 0 0 0 0 rgba(29, 155, 240, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(29, 155, 240, 0); }
    100% { box-shadow: 0 0 0 0 rgba(29, 155, 240, 0); }
  }

  .countdown-hero h1 {
    max-width: 820px;
    margin: 0 auto 1.5rem;
  }

  .countdown-hero h1 .text-gradient {
    display: block;
    margin-top: 0.1em;
  }

  .lead {
    font-size: 1.125rem;
    max-width: 620px;
    margin: 0 auto 3rem;
  }

  /* ---- Countdown Display ---- */
  .countdown {
    display: inline-flex;
    gap: 1rem;
    padding: 1.75rem 2rem;
    margin: 0 auto 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(ellipse at top, rgba(29, 155, 240, 0.05), transparent 60%),
      var(--bg-card);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .count-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 72px;
  }

  .count-num {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.5rem;
  }

  .count-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 1rem;
  }

  /* ---- Expect Grid ---- */
  .expect-wrap {
    text-align: center;
    max-width: 960px;
    margin: 0 auto;
  }

  .expect-wrap h2 {
    margin-bottom: 2.5rem;
  }

  .expect-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    text-align: left;
  }

  .expect-card {
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.3s, transform 0.3s var(--ease-smooth);
  }

  .expect-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .expect-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: rgba(29, 155, 240, 0.08);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .expect-card h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .expect-card p {
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .expect-card a {
    color: var(--accent-light);
    font-weight: 500;
  }

  /* ---- Final CTA ---- */
  .final-section {
    padding-top: 2rem;
  }

  .final-card {
    max-width: 640px;
    margin: 0 auto;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(ellipse at top, rgba(29, 155, 240, 0.05), transparent 60%),
      var(--bg-card);
  }

  .final-card h2 {
    margin-bottom: 0.75rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    .countdown-hero { padding-top: 3.5rem; }
    .countdown { gap: 0.5rem; padding: 1.25rem 1rem; }
    .count-unit { min-width: 56px; }
    .count-num { font-size: 2rem; }
    .count-label { font-size: 0.625rem; }
  }

  @media (max-width: 400px) {
    .count-unit { min-width: 48px; }
    .count-num { font-size: 1.75rem; }
  }
</style>

<script>
  /**
   * 倒计时脚本：每秒刷新 DOM 显示
   * 文件顶端常量 LAUNCH_ISO 已通过 data-target 属性传递到客户端
   */
  const countdownEl = document.getElementById('countdown');
  if (countdownEl) {
    const target = new Date(countdownEl.dataset.target || '').getTime();
    const elDays = document.getElementById('count-days');
    const elHours = document.getElementById('count-hours');
    const elMins = document.getElementById('count-mins');
    const elSecs = document.getElementById('count-secs');

    const pad = (n: number) => String(Math.max(0, Math.floor(n))).padStart(2, '0');

    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        if (elDays) elDays.textContent = '00';
        if (elHours) elHours.textContent = '00';
        if (elMins) elMins.textContent = '00';
        if (elSecs) elSecs.textContent = '00';
        return false;
      }
      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const m = Math.floor((diff / (1000 * 60)) % 60);
      const s = Math.floor((diff / 1000) % 60);
      if (elDays) elDays.textContent = pad(d);
      if (elHours) elHours.textContent = pad(h);
      if (elMins) elMins.textContent = pad(m);
      if (elSecs) elSecs.textContent = pad(s);
      return true;
    };

    tick();
    const timer = setInterval(() => {
      if (!tick()) clearInterval(timer);
    }, 1000);
  }
</script>
