const cols: { key: 'e2ee' | 'metadata' | 'open' | 'signup'; label: string }[] = [
  { key: 'e2ee', label: 'End-to-end encryption' },
  { key: 'metadata', label: 'Metadata & server data' },
  { key: 'open', label: 'Open source' },
  { key: 'signup', label: 'What you need to sign up' },
];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Messaging App Encryption Comparison Table (with Sources)',
  dateModified,
  author: { '@type': 'Organization', name: 'XChat Hub' },
  mainEntityOfPage: 'https://xchat.directory/messaging-app-encryption-comparison',
};
---

<Layout
  title="Messaging App Encryption Comparison Table (Sourced)"
  description="Signal, WhatsApp, Telegram, iMessage, Messenger, Threema, Session, SimpleX, Wire, Element and XChat compared on end-to-end encryption, metadata, open source and sign-up requirements, with a source link for every cell."
  jsonLd={articleJsonLd}
  canonicalPath="/messaging-app-encryption-comparison"
  breadcrumbs={[
    { name: 'Home', url: 'https://xchat.directory/' },
    { name: 'Messaging App Encryption Comparison', url: 'https://xchat.directory/messaging-app-encryption-comparison' },
  ]}
>
  <article>
    <section class="section hero">
      <div class="container">
        <span class="eyebrow">Reference table · Updated {dateModified}</span>
        <h1>Messaging app encryption comparison table</h1>
        <p class="lead text-secondary prose-body">
          Eleven popular messengers compared on four facts: whether chats are end-to-end encrypted by default, what the operator says about metadata,
          whether the code is open source, and what you must hand over to sign up. Every cell links to the official page it is based on, so you can check it and cite it.
        </p>
      </div>
    </section>

    <section class="section-sm">
      <div class="container">
        <div class="cmp-wrap">
          <table class="cmp">
            <thead>
              <tr><th scope="col">App</th>{cols.map((c) => <th scope="col">{c.label}</th>)}</tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row">{r.review ? <a href={r.review}>{r.app}</a> : r.app}</th>
                  {cols.map((c) => (
                    <td>
                      {r[c.key].text}{' '}
                      <a class="src" href={r[c.key].src} rel="noopener nofollow" target="_blank">[{r[c.key].srcLabel}]</a>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-secondary small">Sources were checked on {dateModified}. Policies change; if you spot something out of date, tell us on the <a href="/contact">contact page</a>.</p>
      </div>
    </section>

    <section class="section-sm">
      <div class="container prose-body">
        <h2>How to read this table</h2>
        <ul>
          <li><strong>End-to-end encryption</strong> protects message content from the operator. It says nothing about who you talk to, when, or how often: that is <strong>metadata</strong>.</li>
          <li><strong>Open source</strong> lets outsiders check that the app does what the company says. Open clients with a closed server (Telegram, Threema) still let you verify the encryption on your device.</li>
          <li><strong>Sign-up requirements</strong> decide how easily an account can be linked to your real identity. A phone number is usually tied to an ID document.</li>
        </ul>
        <p>For a ranked recommendation, see <a href="/best-encrypted-messaging-apps/">the best encrypted messaging apps</a>, or head-to-head pages such as <a href="/compare/signal-vs-telegram/">Signal vs Telegram</a> and <a href="/compare/signal-vs-threema/">Signal vs Threema</a>.</p>
        <h2>Cite this table</h2>
        <p>You are welcome to reference or reproduce this table in articles, classes and guides. Please link to <code>https://xchat.directory/messaging-app-encryption-comparison</code> so readers get the updated version.</p>
      </div>
    </section>
  </article>
</Layout>

<style>
  .cmp-wrap { overflow-x: auto; }
  .cmp { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 900px; }
  .cmp th, .cmp td { border: 1px solid var(--border, #2a2a2a); padding: 0.6rem; vertical-align: top; text-align: left; }
  .cmp thead th { position: sticky; top: 0; background: var(--bg-elevated, #111); }
  .cmp .src { font-size: 0.75rem; white-space: nowrap; }
  .small { font-size: 0.85rem; margin-top: 0.75rem; }
</style>
