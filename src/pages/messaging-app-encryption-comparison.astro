    e2ee: { text: 'Not by default. Normal “cloud chats” and all groups use client-server encryption; end-to-end encryption only in opt-in one-to-one Secret Chats.', src: 'https://telegram.org/faq', srcLabel: 'Telegram FAQ' },
    metadata: { text: 'Cloud chats, including group content, are stored on Telegram’s servers so they sync across devices.', src: 'https://telegram.org/faq', srcLabel: 'Telegram FAQ' },
    open: { text: 'Client apps are open source; the server code is not published.', src: 'https://telegram.org/apps', srcLabel: 'telegram.org/apps' },
    signup: { text: 'Phone number required.', src: 'https://telegram.org/faq', srcLabel: 'Telegram FAQ' },
  },
  {
    app: 'iMessage (Apple)',
    e2ee: { text: 'On by default between Apple devices. SMS/RCS fallback messages (green bubbles) are not covered.', src: 'https://support.apple.com/guide/security/imessage-security-overview-secd9764312f/web', srcLabel: 'Apple Platform Security' },
    metadata: { text: 'Messages in iCloud is end-to-end encrypted, but iCloud Backup keys are held by Apple unless Advanced Data Protection is turned on.', src: 'https://support.apple.com/en-us/102651', srcLabel: 'Apple: iCloud data security' },
    open: { text: 'Closed source.', src: 'https://support.apple.com/guide/security/imessage-security-overview-secd9764312f/web', srcLabel: 'Apple Platform Security' },
    signup: { text: 'Apple Account plus a phone number or email address; Apple devices only.', src: 'https://support.apple.com/guide/security/imessage-security-overview-secd9764312f/web', srcLabel: 'Apple Platform Security' },
  },
  {
    app: 'Facebook Messenger',
    e2ee: { text: 'Meta began rolling out default end-to-end encryption for personal chats and calls in December 2023.', src: 'https://about.fb.com/news/2023/12/default-end-to-end-encryption-on-messenger/', srcLabel: 'Meta Newsroom' },
    metadata: { text: 'Runs inside the Facebook account system; Meta’s general data policy applies to account and usage data.', src: 'https://about.fb.com/news/2023/12/default-end-to-end-encryption-on-messenger/', srcLabel: 'Meta Newsroom' },
    open: { text: 'Closed source.', src: 'https://about.fb.com/news/2023/12/default-end-to-end-encryption-on-messenger/', srcLabel: 'Meta Newsroom' },
    signup: { text: 'Facebook / Meta account.', src: 'https://about.fb.com/news/2023/12/default-end-to-end-encryption-on-messenger/', srcLabel: 'Meta Newsroom' },
  },
  {
    app: 'Threema', review: '/reviews/threema/',
    e2ee: { text: 'Always on for all messages, groups and calls.', src: 'https://threema.ch/en/open-source', srcLabel: 'threema.ch' },
    metadata: { text: 'Threema publishes a transparency report on what data it could hand over to authorities.', src: 'https://threema.ch/en/transparencyreport', srcLabel: 'Threema Transparency Report' },
    open: { text: 'Apps are open source; the server is not.', src: 'https://threema.ch/en/open-source', srcLabel: 'Threema: Open source' },
