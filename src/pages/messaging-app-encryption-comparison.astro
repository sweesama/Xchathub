    open: { text: 'Clients and server are open source.', src: 'https://github.com/signalapp', srcLabel: 'github.com/signalapp' },
    signup: { text: 'Phone number required; optional usernames can be shared instead of the number.', src: 'https://signal.org/blog/phone-number-privacy-usernames/', srcLabel: 'Signal blog' },
  },
  {
    app: 'WhatsApp', review: '/reviews/whatsapp/',
    e2ee: { text: 'On by default for personal messages and calls (Signal Protocol). Chat backups are end-to-end encrypted only if you turn that option on.', src: 'https://faq.whatsapp.com/820124435853543', srcLabel: 'WhatsApp Help Center' },
    metadata: { text: 'The privacy policy lists usage and log data, device and connection data and contacts information that WhatsApp collects.', src: 'https://www.whatsapp.com/legal/privacy-policy', srcLabel: 'WhatsApp Privacy Policy' },
