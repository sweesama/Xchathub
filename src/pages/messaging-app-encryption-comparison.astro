    e2ee: { text: 'X describes XChat as end-to-end encrypted. No protocol specification or independent audit had been published at the time of writing.', src: 'https://help.x.com/en/using-x/encrypted-direct-messages', srcLabel: 'X Help Center' },
    metadata: { text: 'Tied to your X account, so X’s account and usage data applies.', src: 'https://help.x.com/en/using-x/encrypted-direct-messages', srcLabel: 'X Help Center' },
    open: { text: 'Closed source.', src: 'https://apps.apple.com/us/app/xchat/id6760873038', srcLabel: 'App Store listing' },
    signup: { text: 'X account; no separate phone number needed.', src: 'https://apps.apple.com/us/app/xchat/id6760873038', srcLabel: 'App Store listing' },
  },
