---
/**
 * messaging-app-encryption-comparison.astro — 主流通讯软件加密/元数据/开源/注册要求对比表
 * 外链诱饵型数据页：每个单元格都附官方来源链接，方便老师、记者、博客引用。
 * 只写官方文档能核实的事实，不写评分或用户量。
 */
import Layout from '../layouts/Layout.astro';

const dateModified = '2026-10-14';

type Cell = { text: string; src: string; srcLabel: string };
type Row = { app: string; review?: string; e2ee: Cell; metadata: Cell; open: Cell; signup: Cell };

const rows: Row[] = [
  {
    app: 'Signal', review: '/reviews/signal/',
