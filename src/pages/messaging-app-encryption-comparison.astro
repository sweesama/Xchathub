    metadata: { text: 'No user identifiers of any kind; contacts connect through one-time links and per-contact message queues.', src: 'https://simplex.chat/', srcLabel: 'simplex.chat' },
    open: { text: 'Clients and servers are open source.', src: 'https://github.com/simplex-chat/simplex-chat', srcLabel: 'GitHub' },
    signup: { text: 'No phone number, email or username.', src: 'https://simplex.chat/', srcLabel: 'simplex.chat' },
  },
  {
    app: 'Wire', review: '/reviews/wire/',
    e2ee: { text: 'Always on for messages, files and calls.', src: 'https://wire.com/en/security', srcLabel: 'Wire Security' },
    metadata: { text: 'Company-run service based in the EU; see Wire’s security page for what is stored.', src: 'https://wire.com/en/security', srcLabel: 'Wire Security' },
