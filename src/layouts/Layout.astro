---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { XCHAT_LAUNCH_DISPLAY } from '../data/xchat';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, any>;
  canonicalPath?: string;
  breadcrumbs?: { name: string; url: string }[];
  /** 主动指定本页 OG 卡路径（以 / 开头，不带域名），默认 /og-image.png */
  ogImage?: string;
  /** OG 卡 alt，默认主仓库 alt */
  ogImageAlt?: string;
}

const {
  title,
  description,
  jsonLd,
  canonicalPath = '',
  breadcrumbs = [],
  ogImage = '/og-image.png',
  ogImageAlt = 'XChat Hub — Public XChat groups directory & launch tracker',
} = Astro.props;

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
} : null;

const siteUrl = 'https://xchat.directory';
const canonicalUrl = `${siteUrl}${canonicalPath}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'XChat Hub',
  url: siteUrl,
  description: `Unofficial community hub for XChat — track Android availability, browse the group directory, and get verified information about the app launched ${XCHAT_LAUNCH_DISPLAY}.`,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/groups?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#000000" />
  <meta name="color-scheme" content="dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={canonicalUrl} />

  <!-- ==== Search Console Verification ====
       拿到 token 后填入以下 content="..." 即可。空 token 时不输出 meta，避免空 meta 污染 head。
       Google: https://search.google.com/search-console (URL Prefix → HTML tag)
       Bing:   https://www.bing.com/webmasters (Settings → Owners → Add site)
       Yandex: https://webmaster.yandex.com (Verification → Meta tag)
       Yandex 已 deprecated，2026 起新站不强制；保留以防老镜像站引用。 -->
  {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
    <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
  )}
  {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
    <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
  )}
  {import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION && (
    <meta name="yandex-verification" content={import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION} />
  )}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="XChat Hub" />

  <link rel="dns-prefetch" href="https://t.me" />
  <link rel="dns-prefetch" href="https://apps.apple.com" />
  <link rel="preconnect" href="https://t.me" crossorigin />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

  <link rel="alternate" type="text/plain" title="LLMs.txt" href="/llms.txt" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="XChat Hub" />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  {jsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  {breadcrumbSchema && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <script is:inline type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-3J5D4C9DPK"></script>
  <script is:inline type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    // Google Consent Mode v2：默认按 cookie banner 偏好决定 analytics_storage
    // cookieConsent 由 CookieBanner.astro 设置（'accepted' / 'necessary' / undefined）
    var initialConsent = (function () {
      try { return localStorage.getItem('xchat-cookie-consent'); } catch (e) { return null; }
    })();
    var analyticsGranted = initialConsent === 'accepted';
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: analyticsGranted ? 'granted' : 'denied',
      wait_for_update: 500,
    });
    if (!analyticsGranted) {
      // GA4 官方提供的硬开关：未同意时阻断所有 hit
      window['ga-disable-G-3J5D4C9DPK'] = true;
    }

    gtag('config', 'G-3J5D4C9DPK', { anonymize_ip: true });

    // 监听 banner 事件，用户后续改变偏好时同步更新 consent 状态
    window.addEventListener('cookie-consent-updated', function (e) {
      var granted = e.detail && e.detail.consent === 'accepted';
      gtag('consent', 'update', {
        analytics_storage: granted ? 'granted' : 'denied',
      });
    });
  </script>

  <!-- ==== Google AdSense Auto Ads ====
       拿到 ca-pub-XXXXX 后取消注释以下三块：
       1) head 里 main 脚本（加载 adsbygoogle.js + push）
       2) 把 src/components/AdSlot.astro 里的 <ADSENSE_PUBLISHER_ID> 替换为真实 ID
       3) 把 <AdSlot ... /> 的 enabled 默认值改成 true
       没有以上三步之前不要启用脚本，否则会报 console warn。 -->
  <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-REPLACE_ME" crossorigin="anonymous"></script> -->
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <CookieBanner />

  <button
    id="back-to-top"
    class="back-to-top"
    aria-label="Back to top"
    type="button"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>

  <style>
    .back-to-top {
      position: fixed;
      right: 1.25rem;
      bottom: 1.25rem;
      z-index: 50;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border);
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease, border-color 0.15s;
    }

    .back-to-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .back-to-top:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  </style>

  <script>
    const btn = document.getElementById('back-to-top');
    if (btn) {
      const toggle = () => {
        if (window.scrollY > window.innerHeight) {
          btn.classList.add('visible');
        } else {
          btn.classList.remove('visible');
        }
      };
      window.addEventListener('scroll', toggle, { passive: true });
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>
</body>
</html>
